{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Octipus",
  "version": "0.1.0",
  "identifier": "cc.octipus.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3008",
    "beforeDevCommand": "npm run tauri:webdev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Octipus",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
