{
  "name": "octipus-mcp-server",
  "version": "0.5.1",
  "description": "MCP server bridge for Octipus — exposes skills, agents, search, and chat as MCP tools",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "octipus",
    "ai-agents",
    "llm",
    "mcp-server",
    "claude",
    "tools"
  ],
  "homepage": "https://github.com/PatriceA/octipus/tree/main/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/PatriceA/octipus/issues"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatriceA/octipus.git",
    "directory": "mcp-server"
  },
  "main": "dist/index.js",
  "bin": {
    "octipus-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "hono": "^4.12.27",
    "qs": "^6.15.2"
  }
}
