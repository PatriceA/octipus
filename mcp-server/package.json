{
  "name": "octipus-mcp-server",
  "version": "0.1.0",
  "description": "MCP server bridge for Octipus — exposes skills, agents, search, and chat as MCP tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PatriceA/octipus.git",
    "directory": "mcp-server"
  },
  "main": "dist/index.js",
  "bin": {
    "assistant-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http --port 3010",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "7.0.1-rc"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "hono": "^4.12.27",
    "qs": "^6.15.2"
  }
}
