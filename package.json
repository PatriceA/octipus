{
  "name": "octipus",
  "version": "0.1.0",
  "description": "Autonomous development assistant with multi-channel support",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PatriceA/octipus.git"
  },
  "bin": {
    "octi": "./bin/octi.mjs",
    "octi-tui-edit": "./bin/octi-tui-edit.mjs"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "tui": "bun run src/tui-pi/index.ts",
    "tui:edit": "bun run src/tui-editor/index.ts",
    "start:all": "bin/octi start",
    "stop:all": "bin/octi stop",
    "build": "bun build src/index.ts --outdir dist --target bun --external playwright --external playwright-core --external chromium-bidi --external electron",
    "build:cli": "bun build --compile --minify --sourcemap bin/octi.ts --outfile dist/octi",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:backfill-skill-embeddings": "bun run scripts/backfill-skill-embeddings.ts",
    "db:backfill-topic-roles": "bun run scripts/backfill-topic-roles.ts",
    "db:check-embedding-drift": "bun run scripts/check-embedding-drift.ts",
    "setup": "bun run scripts/setup-wizard.ts",
    "backup": "bun run scripts/backup.ts",
    "test": "bun test src scripts --timeout 30000",
    "test:tui": "bun test src/tui-pi src/tui-editor --timeout 30000",
    "test:web": "playwright test tests/web",
    "test:web:ui": "playwright test tests/web --ui",
    "test:web:headed": "playwright test tests/web --headed",
    "test:web:list": "playwright test tests/web --list",
    "test:web:install": "playwright install chromium",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:migrate": "DATABASE_URL=postgres://octipus:test@localhost:${TEST_POSTGRES_PORT:-5443}/octipus_test bun run scripts/migrate.ts",
    "test:integration": "bun run scripts/test-integration.ts",
    "test:e2e": "bun run scripts/test-e2e.ts",
    "eval": "bun run src/eval/cli.ts",
    "eval:routing": "bun run src/eval/cli.ts --suite routing",
    "eval:quality": "bun run src/eval/cli.ts --suite quality",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write --unsafe"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-pgvector": "0.0.5",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/swagger": "1.3.1",
    "@mariozechner/pi-tui": "~0.73.1",
    "@simplewebauthn/server": "^13.3.2",
    "@slack/bolt": "^4.7.2",
    "botbuilder": "^4.22.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "grammy": "^1.44.0",
    "ioredis": "^5.11.1",
    "js-tiktoken": "1.0.21",
    "js-yaml": "5.2.2",
    "jszip": "3.10.1",
    "mammoth": "1.12.0",
    "node-pptx-parser": "1.0.1",
    "openai": "^6.44.0",
    "otplib": "^13.4.1",
    "pdfjs-dist": "6.1.200",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "1.62.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "samlify": "2.13.1",
    "word-extractor": "1.0.4",
    "ws": "8.21.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@types/bun": "^1.3.13",
    "@types/js-yaml": "4.0.9",
    "@types/ws": "^8.5.10",
    "drizzle-kit": "^0.31.10",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "web-tree-sitter": "0.26.11"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "axios": "^1.16.1",
    "path-to-regexp": "^8.4.0",
    "ws": "$ws",
    "file-type": "^21.3.4",
    "follow-redirects": "^1.15.12",
    "qs": "^6.15.2",
    "playwright-core": "1.61.1"
  }
}
