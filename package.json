{
  "name": "octipus",
  "version": "0.1.0",
  "description": "Autonomous development assistant with multi-channel support",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PatriceA/octipus.git"
  },
  "bin": {
    "octi": "./bin/octi.mjs",
    "octi-tui-edit": "./bin/octi-tui-edit.mjs"
  },
  "scripts": {
    "dev": "tsx watch --import ./scripts/md-loader.mjs src/index.ts",
    "start": "node dist/index.js",
    "tui": "tsx --import ./scripts/md-loader.mjs src/tui-pi/index.ts",
    "tui:edit": "tsx --import ./scripts/md-loader.mjs src/tui-editor/index.ts",
    "start:all": "bin/octi start web",
    "stop:all": "bin/octi stop",
    "build": "tsx --import ./scripts/md-loader.mjs scripts/build.ts",
    "build:cli": "tsx --import ./scripts/md-loader.mjs scripts/build-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --import ./scripts/md-loader.mjs scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:backfill-skill-embeddings": "tsx --import ./scripts/md-loader.mjs scripts/backfill-skill-embeddings.ts",
    "db:backfill-topic-roles": "tsx --import ./scripts/md-loader.mjs scripts/backfill-topic-roles.ts",
    "db:check-embedding-drift": "tsx --import ./scripts/md-loader.mjs scripts/check-embedding-drift.ts",
    "setup": "tsx --import ./scripts/md-loader.mjs scripts/setup-wizard.ts",
    "backup": "tsx --import ./scripts/md-loader.mjs scripts/backup.ts",
    "test": "vitest run",
    "test:tui": "vitest run src/tui-pi src/tui-editor",
    "test:web": "playwright test tests/web",
    "test:web:ui": "playwright test tests/web --ui",
    "test:web:headed": "playwright test tests/web --headed",
    "test:web:list": "playwright test tests/web --list",
    "test:web:install": "playwright install chromium",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:migrate": "DATABASE_URL=postgres://octipus:test@localhost:${TEST_POSTGRES_PORT:-5443}/octipus_test tsx --import ./scripts/md-loader.mjs scripts/migrate.ts",
    "test:integration": "tsx --import ./scripts/md-loader.mjs scripts/test-integration.ts",
    "test:e2e": "tsx --import ./scripts/md-loader.mjs scripts/test-e2e.ts",
    "eval": "tsx --import ./scripts/md-loader.mjs src/eval/cli.ts",
    "eval:routing": "tsx --import ./scripts/md-loader.mjs src/eval/cli.ts --suite routing",
    "eval:quality": "tsx --import ./scripts/md-loader.mjs src/eval/cli.ts --suite quality",
    "catalog": "tsx --import ./scripts/md-loader.mjs scripts/gen-catalog.ts",
    "catalog:check": "tsx --import ./scripts/md-loader.mjs scripts/gen-catalog.ts --check",
    "root-agent-cost": "tsx --import ./scripts/md-loader.mjs scripts/root-agent-cost.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write --unsafe"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-pgvector": "0.0.5",
    "@hono/node-server": "2.1.1",
    "@mariozechner/pi-tui": "~0.73.1",
    "@simplewebauthn/server": "^13.3.3",
    "@sinclair/typebox": "0.34.52",
    "@slack/bolt": "^4.7.2",
    "botbuilder": "^4.22.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "hono": "4.13.5",
    "js-tiktoken": "1.0.21",
    "js-yaml": "5.4.1",
    "jszip": "3.10.1",
    "mammoth": "1.12.1",
    "node-pptx-parser": "1.0.1",
    "openai": "^7.8.0",
    "otplib": "^13.5.0",
    "pdfjs-dist": "6.2.108",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "1.62.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "samlify": "2.13.1",
    "word-extractor": "1.0.4",
    "ws": "8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@types/bun": "^1.4.0",
    "@types/js-yaml": "4.0.9",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11",
    "web-tree-sitter": "0.26.13"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "axios": "^1.19.0",
    "body-parser": "^2.3.0",
    "path-to-regexp": "^8.4.0",
    "ws": "$ws",
    "file-type": "^21.3.4",
    "follow-redirects": "^1.15.12",
    "qs": "^6.16.0",
    "@xmldom/xmldom": "^0.8.15",
    "playwright-core": "1.62.0"
  }
}
