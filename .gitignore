# Dependencies
node_modules/
**/node_modules/
.bun/
*.tsbuildinfo

# Environment — ignore everything env-related except the example template
.env
.env.*
.env.local
.env.*.local
!.env.example

# Models (large binaries, downloaded at setup)
/models/

# Build output
dist/
.next/
.next-desktop/
out/
# Auto-generated by Next on every dev/build — its single reference flips
# between .next and .next-desktop (desktop dev) distDirs, so tracking it just
# churns. Next regenerates it locally on each run.
web/next-env.d.ts

# Database
*.sqlite
*.sqlite-journal

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Workspace (user files managed by the agent)
workspace/

# Live Artifacts: per-version JS bundles (generated at runtime)
/data/artifacts/

# Playwright
test-results/
playwright-report/

# Vault encryption keys (generated at runtime)
vault-key.json

# Bun lockfile binary
bun.lockb

# Ad-hoc debug/utility scripts at project root
/*.ts
!drizzle.config.ts

# Eval results (generated)
eval/results/*.json

# Claude Code local config & skills
.claude/settings.local.json
.claude/skills/
.mcp.json

# Assistant runtime data (logs, prompt dumps, etc.)
.assistant/
