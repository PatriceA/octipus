# Dependencies
node_modules/
**/node_modules/
.bun/
*.tsbuildinfo

# Environment — ignore everything env-related except the example template
.env
.env.*
.env.local
.env.*.local
!.env.example

# Models (large binaries, downloaded at setup)
/models/

# Build output
dist/
out/

# Database
*.sqlite
*.sqlite-journal

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Workspace (user files managed by the agent)
workspace/

# Live Artifacts: per-version JS bundles (generated at runtime)
/data/artifacts/

# Playwright
test-results/
playwright-report/

# Vault encryption keys (generated at runtime)
vault-key.json

# Bun lockfile binary
bun.lockb

# Ad-hoc debug/utility scripts at project root. Every real root-level config
# needs an exception here, and forgetting one is silent: the file works locally
# and simply does not exist in CI. `vitest.config.ts` was missing for a day —
# CI ran vitest with no config at all, so no path aliases, no project split, and
# 314 suites "failed" on imports that resolve fine on any developer's machine.
/*.ts
!drizzle.config.ts
!playwright.config.ts
!vitest.config.ts
!vite.config.ts

# Eval results (generated)
eval/results/*.json

# Claude Code local config & skills
.claude/settings.local.json
.claude/skills/
# Ephemeral Claude Code git worktrees — must never be committed. One was
# accidentally committed as an orphaned gitlink (no .gitmodules entry), which
# made `git submodule foreach` during checkout's credential-removal step fail
# hard once `persist-credentials: false` was set.
.claude/worktrees/
.mcp.json

# Assistant runtime data (logs, prompt dumps, etc.)
.assistant/

# Test coverage output (bun writes coverage/lcov.info)
coverage/

# stray local log bundle
logs.zip
