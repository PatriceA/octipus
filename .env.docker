# Assistant Docker Configuration
# Copy to .env when running with docker-compose

# ---- Required ----
# Generate secrets with: openssl rand -hex 32
MASTER_KEY=replace-with-openssl-rand-hex-32
JWT_SECRET=replace-with-openssl-rand-hex-32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Database (uses bundled postgres by default)
# DATABASE_URL=postgresql://assistant:assistant@postgres:5432/assistant
# POSTGRES_PASSWORD=assistant

# ---- Optional: Model Providers ----
# At least one provider should be configured

# Ollama (local models — point to host machine or separate container)
# OLLAMA_URL=http://host.docker.internal:11434

# LiteLLM proxy (unified gateway to 100+ providers)
# LITELLM_PROXY_URL=http://host.docker.internal:4000

# Direct cloud providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AI...
# DEEPSEEK_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...

# ---- Optional: Channels ----
# TELEGRAM_BOT_TOKEN=

# ---- Optional: Ports (host-side) ----
# ASSISTANT_API_PORT=3015
# ASSISTANT_WEB_PORT=3017
# POSTGRES_PORT=5442
# REDIS_PORT=6389
