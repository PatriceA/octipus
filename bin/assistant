#!/usr/bin/env bash
set -eu
set -o pipefail 2>/dev/null || true

# ─── Assistant CLI ────────────────────────────────────────────────────────────
# Single-command management for the Assistant application.
#
# Usage:
#   assistant start [--dev]    Start backend + web UI
#   assistant stop             Stop all assistant processes
#   assistant restart [--dev]  Restart everything
#   assistant status           Show running state
#   assistant logs             Tail backend logs
#   assistant open             Open web UI in browser
# ─────────────────────────────────────────────────────────────────────────────

# Resolve project root (follow symlinks, then go up from bin/)
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# State directory
STATE_DIR="$HOME/.assistant"
PID_FILE_BACKEND="$STATE_DIR/backend.pid"
PID_FILE_WEB="$STATE_DIR/web.pid"
LOG_FILE="$STATE_DIR/backend.log"
WEB_LOG_FILE="$STATE_DIR/web.log"

# Ports (match .env defaults)
API_PORT="${API_PORT:-3005}"
WEB_PORT="${WEB_PORT:-3007}"

# Detect storage mode from .env
STORAGE_MODE="embedded"
if [[ -f "$PROJECT_DIR/.env" ]]; then
  _mode=$(grep -E '^STORAGE_MODE=' "$PROJECT_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2 || true)
  if [[ -n "$_mode" ]]; then
    STORAGE_MODE="$_mode"
  fi
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

# ─── Helpers ──────────────────────────────────────────────────────────────────

init_state_dir() {
  mkdir -p "$STATE_DIR"
}

print_banner() {
  echo -e "${CYAN}${BOLD}"
  echo "  ╔═══════════════════════════════════╗"
  echo "  ║         A S S I S T A N T         ║"
  echo "  ╚═══════════════════════════════════╝"
  echo -e "${NC}"
}

log_info() {
  echo -e "  ${GREEN}✓${NC} $1"
}

log_warn() {
  echo -e "  ${YELLOW}!${NC} $1"
}

log_error() {
  echo -e "  ${RED}✗${NC} $1"
}

log_step() {
  echo -e "  ${BLUE}→${NC} $1"
}

log_hint() {
  echo -e "    ${DIM}$1${NC}"
}

is_running() {
  local pid_file="$1"
  if [[ -f "$pid_file" ]]; then
    local pid
    pid=$(cat "$pid_file")
    if kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    # Stale PID file
    rm -f "$pid_file"
  fi
  return 1
}

get_pid() {
  local pid_file="$1"
  if [[ -f "$pid_file" ]]; then
    cat "$pid_file"
  fi
}

open_browser() {
  local url="$1"
  case "$(uname -s)" in
    Linux*)  xdg-open "$url" 2>/dev/null || true ;;
    Darwin*) open "$url" 2>/dev/null || true ;;
    MINGW*|CYGWIN*|MSYS*) start "" "$url" 2>/dev/null || true ;;
    *) log_warn "Cannot detect OS for browser. Open manually: $url" ;;
  esac
}

wait_for_health() {
  local url="$1"
  local max_attempts="${2:-30}"
  local attempt=0

  while [[ $attempt -lt $max_attempts ]]; do
    if curl -sf "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

check_dependency() {
  if ! command -v "$1" &>/dev/null; then
    log_error "$1 is not installed. $2"
    return 1
  fi
}

check_service() {
  local host="$1"
  local port="$2"

  if (echo >/dev/tcp/"$host"/"$port") 2>/dev/null; then
    return 0
  else
    return 1
  fi
}

# Kill any process using a given port
kill_port_users() {
  local port="$1"
  local pids
  pids=$(lsof -ti :"$port" 2>/dev/null || true)
  if [[ -n "$pids" ]]; then
    for pid in $pids; do
      kill "$pid" 2>/dev/null || true
    done
    sleep 0.5
    # Force kill stragglers
    for pid in $pids; do
      kill -9 "$pid" 2>/dev/null || true
    done
  fi
}

# Kill a tracked process and its children
kill_tracked() {
  local pid_file="$1"
  local label="$2"

  if [[ -f "$pid_file" ]]; then
    local pid
    pid=$(cat "$pid_file")
    if kill -0 "$pid" 2>/dev/null; then
      log_step "Stopping $label (PID $pid)..."
      # Kill process group to catch child processes
      kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
      # Wait for graceful shutdown
      local i
      for i in $(seq 1 10); do
        if ! kill -0 "$pid" 2>/dev/null; then
          break
        fi
        sleep 0.5
      done
      # Force kill if still alive
      kill -9 "$pid" 2>/dev/null || true
      log_info "$label stopped"
    fi
    rm -f "$pid_file"
  fi
}

# Kill all assistant-related processes (orphans included)
kill_all_assistant() {
  # Kill tracked processes
  kill_tracked "$PID_FILE_BACKEND" "backend"
  kill_tracked "$PID_FILE_WEB" "web UI"

  # Kill orphaned bun/next processes for this project
  pkill -f "bun.*src/index.ts" 2>/dev/null || true
  pkill -f "next.*${WEB_PORT}" 2>/dev/null || true
  pkill -f "bun run dev.*${PROJECT_DIR}" 2>/dev/null || true
  pkill -f "bun run start.*${PROJECT_DIR}" 2>/dev/null || true

  # Free up ports
  kill_port_users "$API_PORT"
  kill_port_users "$WEB_PORT"

  # Clean stale PID files
  rm -f "$PID_FILE_BACKEND" "$PID_FILE_WEB"
}

# Diagnose why the backend failed to start
diagnose_backend_failure() {
  echo ""
  log_error "Backend failed to start. Running diagnostics..."
  echo ""

  local issues=0

  # Check if port is in use
  if check_service "localhost" "$API_PORT"; then
    log_error "Port $API_PORT is already in use by another process"
    log_hint "Run: lsof -i :$API_PORT"
    issues=$((issues + 1))
  fi

  # Check PostgreSQL
  if ! check_service "localhost" "5432"; then
    log_error "PostgreSQL is not reachable on port 5432"
    log_hint "Run: cd ~/docker-services && docker compose up -d db"
    issues=$((issues + 1))
  else
    log_info "PostgreSQL is reachable"
  fi

  # Check Redis
  if ! check_service "localhost" "6379"; then
    log_error "Redis is not reachable on port 6379"
    log_hint "Run: cd ~/docker-services && docker compose up -d redis"
    issues=$((issues + 1))
  else
    log_info "Redis is reachable"
  fi

  # Check .env
  if [[ ! -f "$PROJECT_DIR/.env" ]]; then
    log_error ".env file not found"
    log_hint "Run: cp .env.example .env  (or: bun run setup)"
    issues=$((issues + 1))
  else
    log_info ".env file exists"
    # Check required vars
    if ! grep -q "DATABASE_URL=" "$PROJECT_DIR/.env" 2>/dev/null; then
      log_error "DATABASE_URL not set in .env"
      issues=$((issues + 1))
    fi
    if ! grep -q "MASTER_KEY=" "$PROJECT_DIR/.env" 2>/dev/null; then
      log_error "MASTER_KEY not set in .env"
      issues=$((issues + 1))
    fi
  fi

  # Check node_modules
  if [[ ! -d "$PROJECT_DIR/node_modules" ]]; then
    log_error "Dependencies not installed"
    log_hint "Run: bun install"
    issues=$((issues + 1))
  fi

  # Show last few log lines
  if [[ -f "$LOG_FILE" ]]; then
    echo ""
    log_step "Last log entries:"
    echo -e "  ${DIM}"
    tail -5 "$LOG_FILE" 2>/dev/null | sed 's/^/    /'
    echo -e "  ${NC}"
  fi

  if [[ $issues -eq 0 ]]; then
    log_warn "No obvious issues found. Check full logs with: assistant logs"
  else
    echo ""
    log_error "Found $issues issue(s). Fix them and try again."
  fi
}

# ─── Commands ─────────────────────────────────────────────────────────────────

cmd_start() {
  local dev_mode=false
  for arg in "$@"; do
    case "$arg" in
      --dev|-d) dev_mode=true ;;
    esac
  done

  init_state_dir
  print_banner

  # Kill any existing processes first (clean slate)
  if is_running "$PID_FILE_BACKEND" || is_running "$PID_FILE_WEB"; then
    log_step "Stopping existing processes..."
    kill_all_assistant
    sleep 1
  fi

  # Also free ports if something else grabbed them
  if check_service "localhost" "$API_PORT"; then
    log_warn "Port $API_PORT in use, killing occupant..."
    kill_port_users "$API_PORT"
    sleep 0.5
  fi

  # Check dependencies
  log_step "Checking dependencies..."
  check_dependency "bun" "Install from https://bun.sh" || return 1

  # Check required services (only for external storage mode)
  if [[ "$STORAGE_MODE" == "external" ]]; then
    log_step "Checking services..."
    local services_ok=true

    if check_service "localhost" "5432"; then
      log_info "PostgreSQL is reachable"
    else
      log_error "PostgreSQL not reachable on port 5432"
      log_hint "Start it: cd ~/docker-services && docker compose up -d db"
      services_ok=false
    fi

    if check_service "localhost" "6379"; then
      log_info "Redis is reachable"
    else
      log_error "Redis not reachable on port 6379"
      log_hint "Start it: cd ~/docker-services && docker compose up -d redis"
      services_ok=false
    fi

    if [[ "$services_ok" == false ]]; then
      echo ""
      log_error "Required services are not running. Cannot start."
      return 1
    fi
  else
    log_info "Embedded mode (PGlite + in-memory cache)"
  fi

  # Build MCP server (so CLI clients get latest tools)
  if [[ -f "$PROJECT_DIR/mcp-server/package.json" ]]; then
    log_step "Building MCP server..."
    cd "$PROJECT_DIR/mcp-server" && npm run build --silent 2>/dev/null && log_info "MCP server built" || log_warn "MCP build failed (non-critical)"
    cd "$PROJECT_DIR"
  fi

  # Start backend
  if [[ "$dev_mode" == true ]]; then
    log_step "Starting backend (dev mode with hot reload)..."
    cd "$PROJECT_DIR"
    nohup bun run dev > "$LOG_FILE" 2>&1 &
  else
    log_step "Starting backend..."
    cd "$PROJECT_DIR"
    nohup bun run start > "$LOG_FILE" 2>&1 &
  fi
  echo $! > "$PID_FILE_BACKEND"

  # Wait for backend to be healthy BEFORE starting web UI
  log_step "Waiting for backend to be ready..."
  if wait_for_health "http://localhost:$API_PORT/api/health" 60; then
    log_info "Backend is ready on port $API_PORT"
  else
    # Backend didn't come up — diagnose and bail
    kill_tracked "$PID_FILE_BACKEND" "backend"
    diagnose_backend_failure
    return 1
  fi

  # Clear Next.js cache so code changes take effect
  log_step "Clearing web UI cache..."
  rm -rf "$PROJECT_DIR/web/.next"
  rm -rf "$PROJECT_DIR/web/node_modules/.cache"

  # Start web UI only after backend is confirmed healthy
  cd "$PROJECT_DIR/web"
  if [[ "$dev_mode" == true ]]; then
    log_step "Starting web UI (dev mode)..."
    nohup bun run dev > "$WEB_LOG_FILE" 2>&1 &
  else
    log_step "Building web UI..."
    if ! bun run build >> "$WEB_LOG_FILE" 2>&1; then
      log_warn "Production build failed, using dev mode instead"
      nohup bun run dev > "$WEB_LOG_FILE" 2>&1 &
    else
      log_step "Starting web UI..."
      nohup bun run start >> "$WEB_LOG_FILE" 2>&1 &
    fi
  fi
  echo $! > "$PID_FILE_WEB"

  # Wait briefly for web UI
  sleep 2
  log_info "Web UI starting on port $WEB_PORT"

  # Open browser
  log_step "Opening browser..."
  open_browser "http://localhost:$WEB_PORT"

  echo ""
  echo -e "  ${GREEN}${BOLD}Assistant is running!${NC}"
  echo ""
  echo -e "  Web UI:    ${CYAN}http://localhost:$WEB_PORT${NC}"
  echo -e "  API:       ${CYAN}http://localhost:$API_PORT${NC}"
  echo -e "  API Docs:  ${CYAN}http://localhost:$API_PORT/swagger${NC}"
  echo ""
  echo -e "  ${BOLD}Commands:${NC}"
  echo -e "  assistant status    Show running state"
  echo -e "  assistant logs      View backend logs"
  echo -e "  assistant stop      Stop everything"
  echo ""
}

cmd_stop() {
  init_state_dir
  print_banner

  local had_processes=false

  if is_running "$PID_FILE_BACKEND" || is_running "$PID_FILE_WEB"; then
    had_processes=true
  fi

  kill_all_assistant

  if [[ "$had_processes" == true ]]; then
    echo ""
    log_info "Assistant stopped"
  else
    log_info "No assistant processes were running"
    # Still clean up orphans silently
  fi
}

cmd_restart() {
  init_state_dir
  print_banner

  local dev_mode=false
  for arg in "$@"; do
    case "$arg" in
      --dev|-d) dev_mode=true ;;
    esac
  done

  # ── 1. STOP ──────────────────────────────────────────────────────────────────
  log_step "Stopping all processes..."
  kill_all_assistant
  sleep 1

  # ── 2. CLEAR CACHES ─────────────────────────────────────────────────────────
  log_step "Clearing caches..."
  rm -rf "$PROJECT_DIR/web/.next"
  rm -rf "$PROJECT_DIR/web/node_modules/.cache"
  log_info "Caches cleared"

  echo ""

  # ── 3. START ─────────────────────────────────────────────────────────────────

  # Check dependencies
  log_step "Checking dependencies..."
  check_dependency "bun" "Install from https://bun.sh" || return 1

  # Check required services (only for external storage mode)
  if [[ "$STORAGE_MODE" == "external" ]]; then
    log_step "Checking services..."
    local services_ok=true

    if check_service "localhost" "5432"; then
      log_info "PostgreSQL is reachable"
    else
      log_error "PostgreSQL not reachable on port 5432"
      log_hint "Start it: cd ~/docker-services && docker compose up -d db"
      services_ok=false
    fi

    if check_service "localhost" "6379"; then
      log_info "Redis is reachable"
    else
      log_error "Redis not reachable on port 6379"
      log_hint "Start it: cd ~/docker-services && docker compose up -d redis"
      services_ok=false
    fi

    if [[ "$services_ok" == false ]]; then
      echo ""
      log_error "Required services are not running. Cannot start."
      return 1
    fi
  else
    log_info "Embedded mode (PGlite + in-memory cache)"
  fi

  # Build MCP server (so CLI clients get latest tools)
  if [[ -f "$PROJECT_DIR/mcp-server/package.json" ]]; then
    log_step "Building MCP server..."
    cd "$PROJECT_DIR/mcp-server" && npm run build --silent 2>/dev/null && log_info "MCP server built" || log_warn "MCP build failed (non-critical)"
    cd "$PROJECT_DIR"
  fi

  # Start backend
  if [[ "$dev_mode" == true ]]; then
    log_step "Starting backend (dev mode with hot reload)..."
    cd "$PROJECT_DIR"
    nohup bun run dev > "$LOG_FILE" 2>&1 &
  else
    log_step "Starting backend..."
    cd "$PROJECT_DIR"
    nohup bun run start > "$LOG_FILE" 2>&1 &
  fi
  echo $! > "$PID_FILE_BACKEND"

  log_step "Waiting for backend to be ready..."
  if wait_for_health "http://localhost:$API_PORT/api/health" 60; then
    log_info "Backend is ready on port $API_PORT"
  else
    kill_tracked "$PID_FILE_BACKEND" "backend"
    diagnose_backend_failure
    return 1
  fi

  # Start web UI (cache already cleared above)
  cd "$PROJECT_DIR/web"
  if [[ "$dev_mode" == true ]]; then
    log_step "Starting web UI (dev mode)..."
    nohup bun run dev > "$WEB_LOG_FILE" 2>&1 &
  else
    log_step "Building web UI..."
    if ! bun run build >> "$WEB_LOG_FILE" 2>&1; then
      log_warn "Production build failed, using dev mode instead"
      nohup bun run dev > "$WEB_LOG_FILE" 2>&1 &
    else
      log_step "Starting web UI..."
      nohup bun run start >> "$WEB_LOG_FILE" 2>&1 &
    fi
  fi
  echo $! > "$PID_FILE_WEB"

  sleep 2
  log_info "Web UI starting on port $WEB_PORT"

  log_step "Opening browser..."
  open_browser "http://localhost:$WEB_PORT"

  echo ""
  echo -e "  ${GREEN}${BOLD}Assistant is running!${NC}"
  echo ""
  echo -e "  Web UI:    ${CYAN}http://localhost:$WEB_PORT${NC}"
  echo -e "  API:       ${CYAN}http://localhost:$API_PORT${NC}"
  echo -e "  API Docs:  ${CYAN}http://localhost:$API_PORT/swagger${NC}"
  echo ""
}

cmd_status() {
  init_state_dir
  print_banner

  echo -e "  ${BOLD}Process Status${NC}"
  echo ""

  if is_running "$PID_FILE_BACKEND"; then
    local pid
    pid=$(get_pid "$PID_FILE_BACKEND")
    log_info "Backend:  running (PID $pid) on port $API_PORT"
  else
    log_error "Backend:  not running"
  fi

  if is_running "$PID_FILE_WEB"; then
    local pid
    pid=$(get_pid "$PID_FILE_WEB")
    log_info "Web UI:   running (PID $pid) on port $WEB_PORT"
  else
    log_error "Web UI:   not running"
  fi

  echo ""
  echo -e "  ${BOLD}Service Status${NC}  ${DIM}(${STORAGE_MODE} mode)${NC}"
  echo ""

  if [[ "$STORAGE_MODE" == "external" ]]; then
    if check_service "localhost" "5432"; then
      log_info "PostgreSQL: reachable (port 5432)"
    else
      log_error "PostgreSQL: not reachable"
      log_hint "cd ~/docker-services && docker compose up -d db"
    fi

    if check_service "localhost" "6379"; then
      log_info "Redis:      reachable (port 6379)"
    else
      log_error "Redis:      not reachable"
      log_hint "cd ~/docker-services && docker compose up -d redis"
    fi
  else
    log_info "PGlite:     embedded database"
    log_info "Cache:      in-memory"
  fi

  if check_service "localhost" "11434"; then
    log_info "Ollama:     reachable (port 11434)"
  else
    log_warn "Ollama:     not reachable (optional)"
  fi

  if check_service "localhost" "4000"; then
    log_info "LiteLLM:    reachable (port 4000)"
  else
    log_warn "LiteLLM:    not reachable (optional)"
  fi

  # API health check
  echo ""
  if curl -sf "http://localhost:$API_PORT/api/health" >/dev/null 2>&1; then
    log_info "API Health: healthy"
  else
    log_error "API Health: unreachable"
  fi

  echo ""
  echo -e "  ${BOLD}URLs${NC}"
  echo -e "  Web UI:    ${CYAN}http://localhost:$WEB_PORT${NC}"
  echo -e "  API:       ${CYAN}http://localhost:$API_PORT${NC}"
  echo -e "  API Docs:  ${CYAN}http://localhost:$API_PORT/swagger${NC}"
  echo ""
}

cmd_logs() {
  init_state_dir

  local log_target="$LOG_FILE"
  for arg in "$@"; do
    case "$arg" in
      --web|-w) log_target="$WEB_LOG_FILE" ;;
    esac
  done

  if [[ -f "$log_target" ]]; then
    tail -f "$log_target"
  else
    log_error "No log file found at $log_target"
    log_error "Start the assistant first: assistant start"
  fi
}

cmd_open() {
  open_browser "http://localhost:$WEB_PORT"
  log_info "Opening http://localhost:$WEB_PORT"
}

cmd_help() {
  print_banner
  echo -e "  ${BOLD}Usage:${NC} assistant <command> [options]"
  echo ""
  echo -e "  ${BOLD}Commands:${NC}"
  echo -e "    start [--dev]    Start backend and web UI"
  echo -e "    stop             Stop all assistant processes"
  echo -e "    restart [--dev]  Restart everything"
  echo -e "    status           Show running state and service health"
  echo -e "    logs [--web]     Tail backend logs (--web for web UI logs)"
  echo -e "    open             Open web UI in browser"
  echo -e "    help             Show this help message"
  echo ""
  echo -e "  ${BOLD}Options:${NC}"
  echo -e "    --dev, -d        Start in development mode (hot reload)"
  echo -e "    --web, -w        Show web UI logs instead of backend"
  echo ""
  echo -e "  ${BOLD}Environment:${NC}"
  echo -e "    API_PORT         Backend API port (default: 3005)"
  echo -e "    WEB_PORT         Web UI port (default: 3007)"
  echo ""
}

# ─── Main ─────────────────────────────────────────────────────────────────────

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    start)   cmd_start "$@" ;;
    stop)    cmd_stop ;;
    restart) cmd_restart "$@" ;;
    status)  cmd_status ;;
    logs)    cmd_logs "$@" ;;
    open)    cmd_open ;;
    help|--help|-h) cmd_help ;;
    *)
      log_error "Unknown command: $command"
      echo ""
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
