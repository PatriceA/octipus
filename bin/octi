#!/usr/bin/env bash
set -eu
set -o pipefail 2>/dev/null || true

# ─── Octipus CLI ────────────────────────────────────────────────────────────
# Single-command management for Octipus.
#
# Usage:
#   octi start [tui|web|desktop]    Start the backend; optionally attach a client
#   octi restart [tui|web|desktop]  Same, after stopping what is running
#                                   (--rebuild, or OCTI_REBUILD=1: rebuild the
#                                   backend, MCP server and web UI even if current)
#   octi stop                       Stop all Octipus processes
#   octi tui                        Terminal chat against a running backend
#   octi open                       Web UI in the browser (starts it if needed)
#   octi desktop [opts]             Desktop app (thin client)
#   octi edit                       TUI editor
#   octi status                     Show running state
#   octi logs                       Tail backend logs
#   octi recovery                   Recovery mode state and the recovery token
#
# `start` is backend-only on purpose: a terminal user should not have to opt
# out of a browser. Name the client you want, or attach one afterwards.
# ─────────────────────────────────────────────────────────────────────────────

# Resolve project root (follow symlinks, then go up from bin/)
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# State directory
STATE_DIR="$HOME/.octipus"
PID_FILE_BACKEND="$STATE_DIR/backend.pid"
PID_FILE_WEB="$STATE_DIR/web.pid"
PID_FILE_DESKTOP="$STATE_DIR/desktop.pid"
LOG_FILE="$STATE_DIR/backend.log"
# Written by scripts/supervisor.mjs: starting / running / recovery.
SUPERVISOR_STATE_FILE="$STATE_DIR/supervisor.json"
RECOVERY_TOKEN_FILE="$STATE_DIR/recovery-token"
WEB_LOG_FILE="$STATE_DIR/web.log"
DESKTOP_LOG_FILE="$STATE_DIR/desktop.log"

# Ports. An explicit process environment value wins, then the checkout's .env,
# then the product default. The backend loads .env itself, but this dispatcher
# also needs the same port for health checks and must export it to web/serve.mjs
# so its same-origin proxy reaches the backend selected during `octi setup`.
if [[ -f "$PROJECT_DIR/.env" ]]; then
  if [[ -z "${API_PORT:-}" ]]; then
    API_PORT=$(grep -E '^API_PORT=' "$PROJECT_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' || true)
  fi
  if [[ -z "${API_PORT:-}" ]]; then
    API_PORT=$(grep -E '^PORT=' "$PROJECT_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' || true)
  fi
  if [[ -z "${WEB_PORT:-}" ]]; then
    WEB_PORT=$(grep -E '^WEB_PORT=' "$PROJECT_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' || true)
  fi
fi
API_PORT="${API_PORT:-3005}"
WEB_PORT="${WEB_PORT:-3007}"
export API_PORT WEB_PORT
# Desktop dev web server (tauri:webdev → next dev -p 3008). Distinct from
# WEB_PORT so the desktop and the browser web UI never collide.
DESKTOP_DEV_PORT="${DESKTOP_DEV_PORT:-3008}"

# Detect storage mode from .env.
# Resolution order matches the backend (src/db/postgres.ts):
#   1. Explicit STORAGE_MODE= line → use that
#   2. DATABASE_URL present (non-empty) → 'external' (backend will connect)
#   3. Fallback → 'embedded' (backend uses PGlite)
STORAGE_MODE="embedded"
if [[ -f "$PROJECT_DIR/.env" ]]; then
  _mode=$(grep -E '^STORAGE_MODE=' "$PROJECT_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2 || true)
  if [[ -n "$_mode" ]]; then
    STORAGE_MODE="$_mode"
  else
    _db_url=$(grep -E '^DATABASE_URL=' "$PROJECT_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- || true)
    if [[ -n "$_db_url" ]]; then
      STORAGE_MODE="external"
    fi
  fi
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

# ─── Helpers ──────────────────────────────────────────────────────────────────

init_state_dir() {
  mkdir -p "$STATE_DIR"
}

# The backend writes JSON log lines when its stdout is a file, as it is here
# (src/utils/logger.ts); pretty-print them on read. Other lines pass through.
pretty_backend_log() {
  local pp="$PROJECT_DIR/node_modules/.bin/pino-pretty"
  if [[ -z "${LOG_FORMAT:-}" && -x "$pp" ]]; then
    "$pp" --colorize --translateTime SYS:standard --ignore pid,hostname
  else
    cat
  fi
}

print_banner() {
  echo -e "${CYAN}${BOLD}"
  echo "  ╔═══════════════════════════════════╗"
  echo "  ║           O C T I P U S           ║"
  echo "  ╚═══════════════════════════════════╝"
  echo -e "${NC}"
}

log_info() {
  echo -e "  ${GREEN}✓${NC} $1"
}

log_warn() {
  echo -e "  ${YELLOW}!${NC} $1"
}

log_error() {
  echo -e "  ${RED}✗${NC} $1"
}

log_step() {
  echo -e "  ${BLUE}→${NC} $1"
}

log_hint() {
  echo -e "    ${DIM}$1${NC}"
}

is_running() {
  local pid_file="$1"
  if [[ -f "$pid_file" ]]; then
    local pid
    pid=$(cat "$pid_file")
    if kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    # Stale PID file
    rm -f "$pid_file"
  fi
  return 1
}

get_pid() {
  local pid_file="$1"
  if [[ -f "$pid_file" ]]; then
    cat "$pid_file"
  fi
}

open_browser() {
  local url="$1"
  [[ "${OCTI_NO_BROWSER:-}" == 1 ]] && return 0
  case "$(uname -s)" in
    Linux*)  xdg-open "$url" 2>/dev/null || true ;;
    Darwin*) open "$url" 2>/dev/null || true ;;
    MINGW*|CYGWIN*|MSYS*) start "" "$url" 2>/dev/null || true ;;
    *) log_warn "Cannot detect OS for browser. Open manually: $url" ;;
  esac
}

regen_mcp_config() {
  # Re-stamps .mcp.json + the user-scope `gemini mcp` registration with
  # the freshest API key. Called twice during start: once before
  # launching the backend (so single-user / legacy installs still get
  # MASTER_KEY wired up immediately) and once after it's healthy
  # (multi-user backends mint ~/.octipus/mcp-token at boot, which only
  # exists after the API server reports healthy).
  if [[ ! -f "$PROJECT_DIR/mcp-server/dist/index.js" ]]; then
    return 0
  fi
  local _mcp_token_path="$HOME/.octipus/mcp-token"
  local _mcp_key=""
  if [[ -f "$_mcp_token_path" ]]; then
    _mcp_key=$(head -n1 "$_mcp_token_path" 2>/dev/null | tr -d '\r\n' || true)
  fi
  if [[ -z "$_mcp_key" ]]; then
    if [[ -z "${MASTER_KEY:-}" && -f "$PROJECT_DIR/.env" ]]; then
      MASTER_KEY=$(grep -E '^MASTER_KEY=' "$PROJECT_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2 || true)
    fi
    _mcp_key="${MASTER_KEY:-}"
  fi
  local _mcp_entry="$PROJECT_DIR/mcp-server/dist/index.js"
  local _env_block=""
  if [[ -n "$_mcp_key" ]]; then
    _env_block=",\"OCTIPUS_API_KEY\":\"${_mcp_key}\""
  fi
  cat > "$PROJECT_DIR/.mcp.json" <<MCPEOF
{
  "mcpServers": {
    "octipus": {
      "command": "node",
      "args": ["${_mcp_entry}"],
      "env": {
        "OCTIPUS_URL": "http://127.0.0.1:${API_PORT}"${_env_block}
      }
    }
  }
}
MCPEOF
  sync_gemini_mcp_config "$_mcp_entry" "$_mcp_key"
  sync_codex_mcp_config "$_mcp_entry" "$_mcp_key"
}

# Register the Octipus MCP server for the Antigravity (agy) / Gemini CLI family,
# which read ~/.gemini/settings.json. The old `gemini mcp add` command is gone
# (agy replaced the gemini CLI and exposes no `mcp` subcommand), so we merge the
# JSON in place — preserving the user's other settings — and refresh the key on
# every restart. Best effort: only runs if the CLI family is present.
sync_gemini_mcp_config() {
  local _entry="$1"
  local _key="$2"
  command -v agy &>/dev/null || command -v gemini &>/dev/null || [[ -d "$HOME/.gemini" ]] || return 0
  mkdir -p "$HOME/.gemini"
  OCTI_MCP_ENTRY="$_entry" \
  OCTI_MCP_URL="http://127.0.0.1:${API_PORT}" \
  OCTI_MCP_KEY="$_key" \
  OCTI_MCP_SETTINGS="$HOME/.gemini/settings.json" \
    node -e '
      const fs = require("fs");
      const p = process.env.OCTI_MCP_SETTINGS;
      let cfg = {};
      try { cfg = JSON.parse(fs.readFileSync(p, "utf8")); } catch {}
      cfg.mcpServers = cfg.mcpServers || {};
      const env = { OCTIPUS_URL: process.env.OCTI_MCP_URL };
      if (process.env.OCTI_MCP_KEY) env.OCTIPUS_API_KEY = process.env.OCTI_MCP_KEY;
      cfg.mcpServers.octipus = { command: "node", args: [process.env.OCTI_MCP_ENTRY], env, trust: true };
      fs.writeFileSync(p, JSON.stringify(cfg, null, 2) + "\n");
    ' >/dev/null 2>&1 || true
}

# Sync the Octipus MCP entry in Codex's config (~/.codex/config.toml).
# Codex MCP discovery is static — without this, a project rename or key
# rotation leaves the codex CLI pointing at stale paths. Best effort: only
# touches the file if Codex has been installed (config dir exists).
sync_codex_mcp_config() {
  local _entry="$1"
  local _key="$2"
  local _codex_config="$HOME/.codex/config.toml"
  [[ -d "$HOME/.codex" ]] || return 0

  # Ensure the file exists so the rewrite step has something to read.
  touch "$_codex_config"

  # Strip any prior octipus / legacy assistant blocks (header + body, up to
  # next TOML header or EOF), then append a fresh block.
  awk '
    /^\[mcp_servers\.(octipus|assistant)(\.[a-zA-Z0-9_]+)?\]/ { skip = 1; next }
    /^\[/ { skip = 0 }
    !skip { print }
  ' "$_codex_config" > "${_codex_config}.tmp"

  # Drop trailing blank lines, then append our block.
  sed -i -e :a -e '/^\s*$/{$d;N;ba' -e '}' "${_codex_config}.tmp" 2>/dev/null || true

  {
    [[ -s "${_codex_config}.tmp" ]] && echo ""
    echo "[mcp_servers.octipus]"
    echo "command = \"node\""
    echo "args = [\"${_entry}\"]"
    echo ""
    echo "[mcp_servers.octipus.env]"
    echo "OCTIPUS_URL = \"http://127.0.0.1:${API_PORT}\""
    [[ -n "$_key" ]] && echo "OCTIPUS_API_KEY = \"${_key}\""
  } >> "${_codex_config}.tmp"

  mv "${_codex_config}.tmp" "$_codex_config"
}

# Poll `url` until it answers 2xx, for up to `seconds`. Four times a second: a
# warm backend is up in ~2.5 s, and a 1 s poll added up to a second on top.
# With `pid`, give up as soon as that process is gone — it is not coming up.
wait_for_health() {
  local url="$1"
  local seconds="${2:-30}"
  local pid="${3:-}"
  local attempt=0
  local max_attempts=$((seconds * 4))

  while [[ $attempt -lt $max_attempts ]]; do
    if curl -sf "$url" >/dev/null 2>&1; then
      return 0
    fi
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      return 1
    fi
    sleep 0.25
    attempt=$((attempt + 1))
  done
  return 1
}

check_dependency() {
  if ! command -v "$1" &>/dev/null; then
    log_error "$1 is not installed. $2"
    return 1
  fi
}

check_service() {
  local host="$1"
  local port="$2"

  if (echo >/dev/tcp/"$host"/"$port") 2>/dev/null; then
    return 0
  else
    return 1
  fi
}

# Detect platform
IS_WINDOWS=false
if [[ "$(uname -s)" == MINGW* ]] || [[ "$(uname -s)" == MSYS* ]] || [[ "$(uname -s)" == CYGWIN* ]] || [[ "$OSTYPE" == msys ]] || [[ "$OSTYPE" == cygwin ]]; then
  IS_WINDOWS=true
fi

# Kill any process using a given port
kill_port_users() {
  local port="$1"

  if [[ "$IS_WINDOWS" == true ]]; then
    # Windows: use netstat + taskkill
    local pids
    pids=$(netstat -ano 2>/dev/null | grep ":${port} " | grep "LISTENING" | awk '{print $NF}' | sort -u || true)
    for pid in $pids; do
      if [[ -n "$pid" && "$pid" != "0" ]]; then
        taskkill //F //PID "$pid" >/dev/null 2>&1 || true
      fi
    done
  else
    # Unix: try lsof → ss → fuser, in that order. lsof is missing on
    # some minimal installs (Manjaro, Alpine), so always fall through.
    local pids=""
    if command -v lsof >/dev/null 2>&1; then
      pids=$(lsof -ti :"$port" 2>/dev/null || true)
    fi
    if [[ -z "$pids" ]] && command -v ss >/dev/null 2>&1; then
      # ss output: "users:(("node",pid=110914,fd=34))" — extract pid=NNN
      pids=$(ss -tlnpH "( sport = :$port )" 2>/dev/null \
        | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u || true)
    fi
    if [[ -z "$pids" ]] && command -v fuser >/dev/null 2>&1; then
      pids=$(fuser -n tcp "$port" 2>/dev/null || true)
    fi
    if [[ -n "$pids" ]]; then
      for pid in $pids; do
        kill "$pid" 2>/dev/null || true
      done
      sleep 0.5
      for pid in $pids; do
        kill -9 "$pid" 2>/dev/null || true
      done
    fi
  fi
}

# Kill a tracked process and its children
# Optional third argument: how many half-seconds to wait for a graceful exit
# before SIGKILL (default 10).
kill_tracked() {
  local pid_file="$1"
  local label="$2"
  local wait_halves="${3:-10}"

  if [[ -f "$pid_file" ]]; then
    local pid
    pid=$(cat "$pid_file" 2>/dev/null || true)
    if [[ -z "$pid" ]]; then
      rm -f "$pid_file"
      return
    fi
    if kill -0 "$pid" 2>/dev/null; then
      log_step "Stopping $label (PID $pid)..."
      if [[ "$IS_WINDOWS" == true ]]; then
        taskkill //F //PID "$pid" //T >/dev/null 2>&1 || true
      else
        kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
        local i
        for i in $(seq 1 "$wait_halves"); do
          if ! kill -0 "$pid" 2>/dev/null; then break; fi
          sleep 0.5
        done
        # SIGKILL the whole process group, not just the tracked pid: a backend
        # whose graceful shutdown hangs leaves the wrapper as $pid but the real
        # work (index.ts) as a child. Killing only $pid orphans that child
        # (reparented to init, port already unbound) — exactly the "backend
        # went down but process survives" failure. Negative pid = process group.
        kill -9 -- -"$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
      fi
      log_info "$label stopped"
    fi
    rm -f "$pid_file"
  fi
}

# kill all octipus-related processes (orphans included)
kill_all_octipus() {
  # Kill tracked processes. 12 s for the backend: its PID file names the
  # supervisor, which gives the backend 6 s to shut down before exiting itself.
  # Killing the supervisor sooner orphans a slow backend.
  kill_tracked "$PID_FILE_BACKEND" "backend" 24
  kill_tracked "$PID_FILE_WEB" "web UI"

  if [[ "$IS_WINDOWS" == true ]]; then
    # Windows: kill the node processes running our project files
    local pids
    pids=$(WMIC process where "name='node.exe'" get ProcessId,CommandLine 2>/dev/null \
      | grep -i "$(echo "$PROJECT_DIR" | tr '/' '\\')" \
      | awk '{print $NF}' || true)
    for pid in $pids; do
      if [[ -n "$pid" && "$pid" != "0" ]]; then
        taskkill //F //PID "$pid" //T >/dev/null 2>&1 || true
      fi
    done
    # Also kill any node processes for the web UI (next.js)
    local node_pids
    node_pids=$(WMIC process where "name='node.exe'" get ProcessId,CommandLine 2>/dev/null \
      | grep -i "next" | awk '{print $NF}' || true)
    for pid in $node_pids; do
      if [[ -n "$pid" && "$pid" != "0" ]]; then
        taskkill //F //PID "$pid" //T >/dev/null 2>&1 || true
      fi
    done
  else
    # Unix: pkill orphans. The servers are started by absolute path, so the
    # patterns name this checkout: a bare "node.*dist/index.js" also killed
    # every other Node app's dist/index.js on the machine, MCP servers
    # included (this checkout's own mcp-server/dist/index.js among them).
    # The supervisor first: it would restart a backend killed before it.
    pkill -f "node.*${PROJECT_DIR}/scripts/supervisor.mjs" 2>/dev/null || true
    pkill -f "node.*${PROJECT_DIR}/dist/index.js" 2>/dev/null || true
    pkill -f "node.*${PROJECT_DIR}/.last-good-build/index.js" 2>/dev/null || true
    pkill -f "tsx.*src/index.ts" 2>/dev/null || true
    pkill -f "node.*${PROJECT_DIR}/web/serve.mjs" 2>/dev/null || true
  fi

  # Free up ports
  kill_port_users "$API_PORT"
  kill_port_users "$WEB_PORT"

  sleep 1

  # Clean stale PID files
  rm -f "$PID_FILE_BACKEND" "$PID_FILE_WEB" "$SUPERVISOR_STATE_FILE"
}

# The supervisor's mode (starting / running / recovery), or nothing.
supervisor_mode() {
  [[ -f "$SUPERVISOR_STATE_FILE" ]] || return 0
  grep -oE '"mode": *"[a-z-]+"' "$SUPERVISOR_STATE_FILE" 2>/dev/null | head -1 | sed -E 's/.*"([a-z-]+)"$/\1/' || true
}

# `octi restart` / `octi stop` asked for from inside the backend — the shell
# tool, a CLI agent, a chat on your phone. The command is then a child of the
# process it is about to stop, and the backend reaps its children's process
# groups when it shuts down: the restart died after the stop and before the
# start, and nothing came back. So hand the command to a detached process (its
# own session, outside the backend's process groups) and return at once.
#
# OCTIPUS_INSIDE_PID is set by the backend and the supervisor for everything
# they spawn. Returns non-zero when no hand-off was needed.
handoff_if_inside_backend() {
  local cmd="$1"
  shift
  [[ -n "${OCTIPUS_INSIDE_PID:-}" ]] || return 1
  [[ "$IS_WINDOWS" == true ]] && return 1
  init_state_dir
  local handoff_log="$STATE_DIR/$cmd.log"
  # Node rather than setsid(1), which macOS does not ship. The detached copy
  # runs without OCTIPUS_INSIDE_PID, so it does the work instead of handing
  # off again; nothing else marks it, so the backend it starts (which gets the
  # variable afresh from the supervisor) hands off the next restart too.
  if ! node -e '
    const { spawn } = require("node:child_process");
    const { openSync } = require("node:fs");
    const [log, ...argv] = process.argv.slice(1);
    delete process.env.OCTIPUS_INSIDE_PID;
    const fd = openSync(log, "w");
    spawn("bash", argv, { detached: true, stdio: ["ignore", fd, fd] }).unref();
  ' "$handoff_log" "$REAL_SCRIPT" "$cmd" "$@"; then
    log_warn "Could not detach '$cmd' — running it here"
    return 1
  fi
  log_info "Running inside Octipus — '$cmd' handed off to a detached process"
  log_hint "Its output: $handoff_log"
  if [[ "$cmd" == restart ]]; then
    log_hint "The backend goes down now and should answer again in a minute or two."
    log_hint "If it cannot start, it comes up in recovery mode on port $API_PORT (/api/recovery)."
  fi
  return 0
}

# Stop the desktop app — every flavor of it. Kept separate from
# kill_all_octipus so start/restart's clean-slate never closes the desktop
# window; only an explicit `octi stop`/`octi uninstall` reaps it. Reaps:
#   1. the backgrounded instance we track (setsid group → negative-PID kill)
#   2. untracked instances — a foreground launch ('octi desktop -f'), a built
#      bundle, or a stale one whose PID file is gone — by process/port match.
kill_desktop() {
  kill_tracked "$PID_FILE_DESKTOP" "desktop app"

  if [[ "$IS_WINDOWS" == true ]]; then
    taskkill //F //IM "Octipus.exe" //T >/dev/null 2>&1 || true
  else
    # tauri dev wrapper + its desktop dev web server, and the built binary
    # (productName "Octipus", identifier cc.octipus.desktop). Scope path-based
    # patterns to THIS checkout so we never kill another project's `tauri dev`
    # or another user's next server on a shared machine — the child node
    # procs carry the absolute project path in their argv. The bundle
    # identifier is app-unique, so it needs no path scope.
    pkill -f "${PROJECT_DIR}.*tauri dev" 2>/dev/null || true
    pkill -f "${PROJECT_DIR}.*next dev -p ${DESKTOP_DEV_PORT}" 2>/dev/null || true
    pkill -f "${PROJECT_DIR}/web/src-tauri/target/.*/octipus" 2>/dev/null || true
    pkill -f "cc.octipus.desktop" 2>/dev/null || true
    kill_port_users "$DESKTOP_DEV_PORT"
  fi

  rm -f "$PID_FILE_DESKTOP"
}

# Diagnose why the backend failed to start
diagnose_backend_failure() {
  echo ""
  log_error "Backend failed to start. Running diagnostics..."
  echo ""

  local issues=0

  # Check if port is in use
  if check_service "localhost" "$API_PORT"; then
    log_error "Port $API_PORT is already in use by another process"
    log_hint "Run: lsof -i :$API_PORT"
    issues=$((issues + 1))
  fi

  if [[ "$STORAGE_MODE" != "external" ]]; then
    log_info "Embedded mode — skipping Postgres checks"
  fi

  # Check .env
  if [[ ! -f "$PROJECT_DIR/.env" ]]; then
    log_error ".env file not found"
    log_hint "Run: cp .env.example .env  (or: npm run setup)"
    issues=$((issues + 1))
  else
    log_info ".env file exists"
    # DATABASE_URL is only required in external mode.
    if [[ "$STORAGE_MODE" == "external" ]] && ! grep -q "DATABASE_URL=" "$PROJECT_DIR/.env" 2>/dev/null; then
      log_error "DATABASE_URL not set in .env (required for external storage mode)"
      issues=$((issues + 1))
    fi
    if ! grep -q "MASTER_KEY=" "$PROJECT_DIR/.env" 2>/dev/null; then
      log_error "MASTER_KEY not set in .env"
      issues=$((issues + 1))
    fi
  fi

  # Check node_modules
  if [[ ! -d "$PROJECT_DIR/node_modules" ]]; then
    log_error "Dependencies not installed"
    log_hint "Run: npm install"
    issues=$((issues + 1))
  fi

  # Show recent log lines. 5 was too few — a multi-line error/object (e.g. a
  # config validation dump) pushes the actual "Error:" line out of view, so the
  # tail showed only a trailing "}". 30 lines captures the whole message.
  if [[ -f "$LOG_FILE" ]]; then
    echo ""
    log_step "Last log entries (full log: octi logs):"
    echo -e "  ${DIM}"
    tail -30 "$LOG_FILE" 2>/dev/null | pretty_backend_log | sed 's/^/    /'
    echo -e "  ${NC}"
  fi

  if [[ $issues -eq 0 ]]; then
    log_warn "No obvious issues found. Check full logs with: octi logs"
  else
    echo ""
    log_error "Found $issues issue(s). Fix them and try again."
  fi
}

# ─── Commands ─────────────────────────────────────────────────────────────────

# ─── Shared start plumbing ───────────────────────────────────────────────────
# `start` and `restart` differ only in how they clear the ground first; every
# step after that was duplicated line-for-line between them, which is how the
# two drifted apart. One copy each, called from both.

# Which client to attach after the backend is up, and how to run it.
LAUNCH_TARGET="backend"
LAUNCH_TARGET_EXPLICIT=false
LAUNCH_DEV=false
LAUNCH_CWD=""
# Rebuild the backend, MCP server and web UI even when they look current (a
# build that depends on something the staleness check doesn't see, such as a
# NEXT_PUBLIC_* variable baked into the web bundle).
LAUNCH_REBUILD=false
[[ "${OCTI_REBUILD:-}" == 1 || "${OCTI_REBUILD:-}" == true ]] && LAUNCH_REBUILD=true

# Parse `octi start|restart [tui|web|desktop] [--dev] [--rebuild]`.
#
# The retired flags (`--tui`, `--backend-only`, `--headless`, `--no-web`) are
# still accepted, unlisted: they are in people's shell history and scripts, and
# `--backend-only` is now simply the default. A positional target reads better
# for the thing you do every day.
parse_launch_args() {
  LAUNCH_TARGET="backend"
  LAUNCH_TARGET_EXPLICIT=false
  LAUNCH_DEV=false
  # Captured before any `cd`: an attached TUI pins to the directory you ran the
  # command in, exactly like `octi tui` does.
  LAUNCH_CWD="$PWD"
  for arg in "$@"; do
    case "$arg" in
      tui|--tui|-t) LAUNCH_TARGET="tui"; LAUNCH_TARGET_EXPLICIT=true ;;
      web|webui|browser) LAUNCH_TARGET="web"; LAUNCH_TARGET_EXPLICIT=true ;;
      desktop|app) LAUNCH_TARGET="desktop"; LAUNCH_TARGET_EXPLICIT=true ;;
      --dev|-d) LAUNCH_DEV=true ;;
      --rebuild) LAUNCH_REBUILD=true ;;
      --backend-only|--headless|--no-web) LAUNCH_TARGET="backend"; LAUNCH_TARGET_EXPLICIT=true ;;
      -*) ;; # unknown flags are forwarded/ignored, not fatal
      *)
        log_error "Unknown target: $arg"
        log_hint "Expected one of: tui, web, desktop"
        return 1
        ;;
    esac
  done
}

# Node, storage mode, then the MCP server build.
preflight_checks() {
  log_step "Checking dependencies..."
  check_dependency "node" "Install Node.js 24+ from https://nodejs.org" || return 1

  if [[ "$STORAGE_MODE" != "external" ]]; then
    log_info "Embedded mode (PGlite + in-process cache)"
  else
    log_info "External storage (backend will verify DATABASE_URL)"
  fi

  # Build MCP server (when its sources changed) and register with CLI tools
  if [[ -f "$PROJECT_DIR/mcp-server/package.json" ]]; then
    # mcp-server is not a root workspace: its locked deps are installed on
    # their own, on a fresh clone and whenever its lockfile changed.
    local mcp_deps=0
    ensure_deps mcp-server "$PROJECT_DIR/mcp-server" || mcp_deps=$?
    if [[ $mcp_deps -eq 1 ]]; then log_warn "MCP dep install failed"; fi
    if [[ "$LAUNCH_REBUILD" == true || $mcp_deps -eq 10 ]] || ! node "$PROJECT_DIR/scripts/needs-build.mjs" mcp-server; then
      log_step "Building MCP server..."
      cd "$PROJECT_DIR/mcp-server"
      npm run build --silent 2>/dev/null && log_info "MCP server built" || log_warn "MCP build failed (non-critical)"
      cd "$PROJECT_DIR"
    else
      log_info "MCP server build is current"
    fi

    regen_mcp_config
    log_info ".mcp.json generated"
  fi
}

# Install a package's locked dependencies when its lockfile changed since the
# last install (scripts/needs-install.mjs, shared with the Windows CLI).
#
# A `git pull` that adds a dependency used to leave it uninstalled: the
# rebuilt backend then failed to boot on the missing package and the
# supervisor fell back to the last good build, a version behind, with no sign
# but missing features. Returns 0 when nothing was needed, 10 after an
# install, 1 when the install failed.
ensure_deps() {
  local name="$1" dir="$2"
  node "$PROJECT_DIR/scripts/needs-install.mjs" "$name" && return 0
  log_step "Installing $name dependencies (the lockfile changed since the last install)..."
  if (cd "$dir" && npm ci --no-audit --no-fund >> "$LOG_FILE.install" 2>&1); then
    log_info "$name dependencies installed"
    return 10
  fi
  log_error "Installing $name dependencies failed — see $LOG_FILE.install (run npm ci in $dir)"
  return 1
}

# Rebuild dist/ when it is missing or older than the sources.
#
# The backend runs `node dist/index.js`, which is a build artifact, and
# nothing rebuilt it — so after a `git pull` the backend silently kept serving
# the previous checkout. It reports itself healthy and the only symptom is that
# a change simply is not there.
ensure_backend_build() {
  # Staleness is answered by scripts/needs-build.mjs, shared with the Windows
  # CLI: exit 0 current, exit 1 rebuild.
  [[ "$LAUNCH_REBUILD" != true ]] && node "$PROJECT_DIR/scripts/needs-build.mjs" backend && return 0
  if [[ "$LAUNCH_REBUILD" == true ]]; then
    log_step "Rebuilding the backend..."
  else
    log_step "Rebuilding the backend (sources changed since the last build)..."
  fi
  (cd "$PROJECT_DIR" && npm run build > "$LOG_FILE.build" 2>&1) || {
    log_error "Backend build failed — see $LOG_FILE.build"
    return 1
  }
  log_info "Backend rebuilt"
}

# Spawn the backend and block until it answers /api/health. 2 when it is not up
# but the supervisor carries on (slow boot, recovery mode); otherwise non-zero on failure,
# having already killed the process and printed a diagnosis.
start_backend() {
  cd "$PROJECT_DIR"
  local root_deps=0
  ensure_deps root "$PROJECT_DIR" || root_deps=$?
  if [[ $root_deps -eq 1 ]]; then log_warn "Starting anyway — a dependency the backend needs may be missing"; fi
  if [[ "$LAUNCH_DEV" == true ]]; then
    log_step "Starting backend (dev mode with hot reload)..."
    nohup npm run dev > "$LOG_FILE" 2>&1 &
  else
    # A failed build is not the end: the supervisor falls back to the last
    # build that ran, or to recovery mode, so the machine stays reachable.
    ensure_backend_build || log_warn "Starting anyway — the supervisor falls back to the last good build"
    log_step "Starting backend..."
    # Under scripts/supervisor.mjs, which restarts a backend that crashes or
    # hangs, falls back to the last good build when a new one won't boot, and
    # serves recovery mode on the API port when nothing will. The PID file
    # names the supervisor; stopping it stops the backend. No npm in between:
    # an npm parent sat idle beside the server for its whole life (~50 MB).
    # node_modules/.bin first on PATH, as npm puts it, for anything the
    # backend spawns by name.
    rm -f "$SUPERVISOR_STATE_FILE"
    OCTIPUS_STATE_DIR="$STATE_DIR" PATH="$PROJECT_DIR/node_modules/.bin:$PATH" \
      nohup node "$PROJECT_DIR/scripts/supervisor.mjs" > "$LOG_FILE" 2>&1 &
  fi
  echo $! > "$PID_FILE_BACKEND"

  log_step "Waiting for backend to be ready..."
  if [[ "$LAUNCH_DEV" == true ]]; then
    if wait_for_health "http://localhost:$API_PORT/api/health" 60 "$(get_pid "$PID_FILE_BACKEND")"; then
      log_info "Backend is ready on port $API_PORT"
      regen_mcp_config
      return 0
    fi
    kill_tracked "$PID_FILE_BACKEND" "backend" 24
    diagnose_backend_failure
    return 1
  fi

  local pid attempt=0
  pid=$(get_pid "$PID_FILE_BACKEND")
  # 90 s: a slow first boot fits; past that the supervisor carries on alone.
  while [[ $attempt -lt 360 ]]; do
    if curl -sf "http://localhost:$API_PORT/api/health" >/dev/null 2>&1; then
      log_info "Backend is ready on port $API_PORT"
      # The backend just minted ~/.octipus/mcp-token (multi-user mode);
      # restamp .mcp.json so MCP clients pick it up without a manual step.
      regen_mcp_config
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      kill_tracked "$PID_FILE_BACKEND" "backend" 24
      diagnose_backend_failure
      return 1
    fi
    if [[ "$(supervisor_mode)" == recovery ]]; then
      # Not diagnose_backend_failure: its "port in use" check would blame the
      # recovery server holding the port on purpose.
      echo ""
      log_error "Backend failed to start. Last log entries (full log: octi logs):"
      tail -30 "$LOG_FILE" 2>/dev/null | pretty_backend_log | sed 's/^/    /'
      echo ""
      log_warn "The backend could not start — recovery mode is up on port $API_PORT"
      log_hint "Open http://<host>:$API_PORT/api/recovery, or see: octi recovery"
      return 2
    fi
    sleep 0.25
    attempt=$((attempt + 1))
  done
  log_warn "Backend is not answering yet. The supervisor keeps trying, and falls back to"
  log_warn "the last good build or recovery mode on port $API_PORT if it cannot start it."
  log_hint "Follow it with: octi status · octi logs · octi recovery"
  return 2
}

# Start the backend, then the client the target names. When the backend is not
# up but the supervisor is still in charge (a slow boot, or recovery mode),
# start_backend returns 2 and a web UI target is started anyway: its proxy is
# how a domain, a tunnel or the phone app reaches the API, and recovery mode.
start_and_launch() {
  local rc=0
  start_backend || rc=$?
  if [[ $rc -eq 0 ]]; then
    launch_target
    return
  fi
  if [[ $rc -eq 2 && "$LAUNCH_TARGET" == web ]]; then
    start_web
  fi
  return 1
}

# Build (when its sources changed) or dev-serve the web UI, and open a browser
# at it. The bundle used to be deleted and rebuilt on every start.
start_web() {
  cd "$PROJECT_DIR/web"
  : > "$WEB_LOG_FILE"
  local serve=true web_deps=0
  # The bundle includes its dependencies: new ones mean a new bundle.
  ensure_deps web "$PROJECT_DIR/web" || web_deps=$?
  if [[ "$LAUNCH_DEV" == true ]]; then
    serve=false
  elif [[ "$LAUNCH_REBUILD" == true || $web_deps -eq 10 ]] || ! node "$PROJECT_DIR/scripts/needs-build.mjs" web; then
    log_step "Building web UI..."
    if ! npm run build >> "$WEB_LOG_FILE" 2>&1; then
      log_warn "Production build failed, using dev mode instead (see octi logs --web)"
      serve=false
    fi
  else
    log_info "Web UI build is current"
  fi

  if [[ "$serve" == true ]]; then
    log_step "Starting web UI..."
    # `node serve.mjs` is what `npm run start` ran; see start_backend for why
    # without npm.
    PATH="$PROJECT_DIR/web/node_modules/.bin:$PATH" nohup node "$PROJECT_DIR/web/serve.mjs" >> "$WEB_LOG_FILE" 2>&1 &
  else
    log_step "Starting web UI (dev mode)..."
    nohup npm run dev >> "$WEB_LOG_FILE" 2>&1 &
  fi
  echo $! > "$PID_FILE_WEB"

  if wait_for_health "http://localhost:$WEB_PORT/" 15 "$(get_pid "$PID_FILE_WEB")"; then
    log_info "Web UI is ready on port $WEB_PORT"
  else
    log_warn "Web UI is not answering on port $WEB_PORT yet — see octi logs --web"
  fi
  log_step "Opening browser..."
  open_browser "http://localhost:$WEB_PORT"
}

# Attach whichever client the target names. TUI and desktop replace this
# process, so nothing after them runs.
launch_target() {
  case "$LAUNCH_TARGET" in
    tui)
      echo ""
      echo -e "  ${GREEN}${BOLD}Octipus is running!${NC}"
      echo ""
      echo -e "  API:       ${CYAN}http://localhost:$API_PORT${NC}"
      echo ""
      log_step "Launching TUI..."
      cd "$PROJECT_DIR"
      API_PORT="$API_PORT" exec npm run tui -- --project "$LAUNCH_CWD"
      ;;
    web)
      start_web
      echo ""
      echo -e "  ${GREEN}${BOLD}Octipus is running!${NC}"
      echo ""
      echo -e "  Web UI:    ${CYAN}http://localhost:$WEB_PORT${NC}"
      echo -e "  API:       ${CYAN}http://localhost:$API_PORT${NC}"
      echo -e "  API Docs:  ${CYAN}http://localhost:$API_PORT/swagger${NC}"
      echo ""
      echo -e "  ${BOLD}Commands:${NC}  octi status · octi logs · octi stop"
      echo ""
      ;;
    desktop)
      print_backend_ready
      cmd_desktop
      ;;
    *)
      print_backend_ready
      ;;
  esac
}

# The default ending: a backend, and how to point something at it.
print_backend_ready() {
  echo ""
  echo -e "  ${GREEN}${BOLD}Octipus backend is running!${NC}"
  echo ""
  echo -e "  API:       ${CYAN}http://localhost:$API_PORT${NC}"
  echo -e "  API Docs:  ${CYAN}http://localhost:$API_PORT/swagger${NC}"
  echo ""
  echo -e "  ${BOLD}Attach a client:${NC}"
  echo -e "    octi tui       Terminal chat, pinned to the current directory"
  echo -e "    octi open      Web UI in the browser (starts it if needed)"
  echo -e "    octi desktop   Desktop app"
  echo ""
  echo -e "  octi stop      Stop everything"
  echo ""
}

cmd_start() {
  parse_launch_args "$@" || return 1

  init_state_dir
  print_banner

  # Kill any existing processes first (clean slate)
  if is_running "$PID_FILE_BACKEND" || is_running "$PID_FILE_WEB"; then
    log_step "Stopping existing processes..."
    kill_all_octipus
    sleep 1
  fi

  # Also free ports if something else grabbed them
  if check_service "localhost" "$API_PORT"; then
    log_warn "Port $API_PORT in use, killing occupant..."
    kill_port_users "$API_PORT"
    sleep 0.5
  fi

  preflight_checks || return 1
  start_and_launch
}

cmd_stop() {
  handoff_if_inside_backend stop && return 0
  init_state_dir
  print_banner

  local had_processes=false

  if is_running "$PID_FILE_BACKEND" || is_running "$PID_FILE_WEB" \
    || is_running "$PID_FILE_DESKTOP"; then
    had_processes=true
  fi

  # Stop everything: desktop (all flavors) + backend + web UI.
  kill_desktop
  kill_all_octipus

  if [[ "$had_processes" == true ]]; then
    echo ""
    log_info "Octipus stopped"
  else
    log_info "No Octipus processes were running"
    # Still clean up orphans silently
  fi
}

cmd_restart() {
  parse_launch_args "$@" || return 1
  handoff_if_inside_backend restart "$@" && return 0

  init_state_dir
  print_banner

  # "Start again the same way": a web UI that was up comes back up. Restarting
  # without naming it used to leave it down, and with it anything (a domain, a
  # tunnel, the phone app) that reaches the API through its proxy.
  if [[ "$LAUNCH_TARGET_EXPLICIT" == false ]] && is_running "$PID_FILE_WEB"; then
    LAUNCH_TARGET="web"
    OCTI_NO_BROWSER=1
  fi

  log_step "Stopping all processes..."
  kill_all_octipus
  sleep 1

  log_step "Clearing caches..."
  rm -rf "$PROJECT_DIR/web/dist" "$PROJECT_DIR/web/node_modules/.cache"
  log_info "Caches cleared"
  echo ""

  preflight_checks || return 1
  start_and_launch
}

cmd_status() {
  init_state_dir
  print_banner

  echo -e "  ${BOLD}Process Status${NC}"
  echo ""

  if is_running "$PID_FILE_BACKEND"; then
    local pid mode
    pid=$(get_pid "$PID_FILE_BACKEND")
    mode=$(supervisor_mode)
    case "$mode" in
      recovery) log_error "Backend:  RECOVERY MODE (supervisor PID $pid) on port $API_PORT — see: octi recovery" ;;
      starting) log_warn "Backend:  starting (supervisor PID $pid) on port $API_PORT" ;;
      *) log_info "Backend:  running (PID $pid) on port $API_PORT" ;;
    esac
  else
    log_error "Backend:  not running"
  fi

  if is_running "$PID_FILE_WEB"; then
    local pid
    pid=$(get_pid "$PID_FILE_WEB")
    log_info "Web UI:   running (PID $pid) on port $WEB_PORT"
  else
    log_error "Web UI:   not running"
  fi

  # Only report the desktop app when it was backgrounded by us — a foreground
  # ('octi desktop -f') launch has no tracked PID and isn't ours to report.
  if is_running "$PID_FILE_DESKTOP"; then
    local pid
    pid=$(get_pid "$PID_FILE_DESKTOP")
    log_info "Desktop:  running (PID $pid)"
  fi

  echo ""
  echo -e "  ${BOLD}Service Status${NC}  ${DIM}(${STORAGE_MODE} mode)${NC}"
  echo ""

  if [[ "$STORAGE_MODE" == "external" ]]; then
    log_info "PostgreSQL: checked by backend readiness (DATABASE_URL)"
  else
    log_info "PGlite:     embedded database"
    log_info "Cache:      in-process"
  fi

  if check_service "localhost" "11434"; then
    log_info "Ollama:     reachable (port 11434)"
  else
    log_warn "Ollama:     not reachable (optional)"
  fi

  if check_service "localhost" "4000"; then
    log_info "LiteLLM:    reachable (port 4000)"
  else
    log_warn "LiteLLM:    not reachable (optional)"
  fi

  # API health check
  echo ""
  if curl -sf "http://localhost:$API_PORT/api/health" >/dev/null 2>&1; then
    log_info "API Health: healthy"
  else
    log_error "API Health: unreachable"
  fi

  echo ""
  echo -e "  ${BOLD}URLs${NC}"
  echo -e "  Web UI:    ${CYAN}http://localhost:$WEB_PORT${NC}"
  echo -e "  API:       ${CYAN}http://localhost:$API_PORT${NC}"
  echo -e "  API Docs:  ${CYAN}http://localhost:$API_PORT/swagger${NC}"
  echo ""
}

cmd_logs() {
  init_state_dir

  local log_target="$LOG_FILE"
  for arg in "$@"; do
    case "$arg" in
      --web|-w) log_target="$WEB_LOG_FILE" ;;
    esac
  done

  if [[ -f "$log_target" && "$log_target" == "$LOG_FILE" ]]; then
    tail -f "$log_target" | pretty_backend_log
  elif [[ -f "$log_target" ]]; then
    tail -f "$log_target"
  else
    log_error "No log file found at $log_target"
    log_error "Start Octipus first: octi start"
  fi
}

cmd_open() {
  init_state_dir
  # Opening a browser at a port with nothing behind it is a dead tab and a
  # puzzle. Since `octi start` no longer brings the web UI up by itself, this
  # is where a terminal user asks for it — so start it if it is not there.
  if check_service "localhost" "$WEB_PORT"; then
    open_browser "http://localhost:$WEB_PORT"
    log_info "Opening http://localhost:$WEB_PORT"
    return 0
  fi

  if ! curl -sf "http://localhost:$API_PORT/api/health" >/dev/null 2>&1; then
    log_error "Backend is not running on port $API_PORT"
    log_hint "Start it first: octi start"
    return 1
  fi

  log_step "Web UI is not running — starting it..."
  LAUNCH_DEV=false
  start_web
  echo ""
  echo -e "  Web UI:    ${CYAN}http://localhost:$WEB_PORT${NC}"
  echo ""
}

cmd_desktop() {
  # Launch the Tauri desktop app. The desktop app is a thin CLIENT: it does NOT
  # run its own backend. It connects to any Octipus backend you point it at —
  # a local `octi start`, a LAN host, or a remote deployment. On first launch
  # (or when the saved backend is unreachable) the app shows a connection screen
  # to enter the backend URL.
  local build_mode=false
  local foreground=false
  local stop_mode=false
  for arg in "$@"; do
    case "$arg" in
      --build|-b) build_mode=true ;;
      --foreground|-f) foreground=true ;;
      --stop) stop_mode=true ;;
    esac
  done

  # `octi desktop --stop` tears down the desktop app — the same reaper
  # `octi stop` uses, so it gets every flavor (backgrounded, foreground, built
  # bundle) on Linux, macOS and Windows.
  if $stop_mode; then
    init_state_dir
    local was_tracked=false
    is_running "$PID_FILE_DESKTOP" && was_tracked=true
    log_step "Stopping desktop app…"
    kill_desktop
    if $was_tracked; then
      log_info "Desktop app stopped."
    else
      log_info "Reaped any running desktop processes."
    fi
    return 0
  fi

  if is_running "$PID_FILE_DESKTOP"; then
    log_warn "Desktop app already running (pid $(get_pid "$PID_FILE_DESKTOP"))."
    log_hint "Stop it with 'octi desktop --stop'."
    return 0
  fi

  # Building the desktop client needs the Rust toolchain (+ Tauri system deps).
  # `octi start` doesn't — keep this check local so server installs stay lean.
  if ! command -v cargo >/dev/null 2>&1; then
    log_error "Rust toolchain not found (cargo) — required to build the desktop app."
    log_hint "Install everything the desktop app needs (Rust + Tauri system libs):"
    log_hint "    $PROJECT_DIR/scripts/install-desktop-deps.sh"
    return 1
  fi

  # The desktop app connects to a backend; it doesn't start one. Nudge the user
  # to bring up a local backend if nothing is reachable on the default port.
  if ! is_running "$PID_FILE_BACKEND" \
    && ! curl -sf "http://localhost:$API_PORT/api/health" >/dev/null 2>&1; then
    log_hint "No backend detected on :$API_PORT. Start one with 'octi start',"
    log_hint "or point the app at a remote backend from its connection screen."
  fi

  cd "$PROJECT_DIR/web" || { log_error "web/ directory not found at $PROJECT_DIR/web"; return 1; }

  # ── Self-healing preflight ─────────────────────────────────────────────────
  # Both failures below are fixable without asking, and left alone they surface
  # as a Vite or cargo stack trace that says nothing about the cause.

  # web/ is not a root workspace, so a fresh clone gets here with no deps and
  # `npm run tauri:dev` dies on a missing vite.
  if [[ ! -d node_modules ]]; then
    log_step "Installing web dependencies (first run)…"
    npm install --silent || { log_error "npm install failed in web/ — cannot launch the desktop app."; return 1; }
  fi

  # Tauri loads the window from a fixed devUrl, so a stale listener on the dev
  # port means Vite quietly moves elsewhere and the window opens blank.
  # No-op when the port is free, so it is simply always run.
  kill_port_users "$DESKTOP_DEV_PORT"

  if $build_mode; then
    log_step "Building the desktop app bundle (can take a few minutes)…"
    log_hint "Output: web/src-tauri/target/release/bundle/"
    exec npm run tauri:build
  fi

  if [[ "$OSTYPE" == linux* ]]; then
    node "$PROJECT_DIR/scripts/install-desktop-entry.mjs" || { log_error "Could not register the Octipus desktop launcher"; return 1; }
  fi

  log_step "Launching the Octipus desktop app…"
  log_hint "It connects to a backend (default http://localhost:$API_PORT) — change it in-app."

  if $foreground; then
    # Attached mode: window dies when the terminal closes. tauri:dev starts the
    # web dev server and opens the window. Use 'octi desktop --build' to bundle.
    exec npm run tauri:dev
  fi

  # Default: detach so the GUI survives the terminal closing. Logs go to a file
  # you can tail; we record the leader PID for 'octi desktop --stop'.
  init_state_dir
  if command -v setsid >/dev/null 2>&1; then
    # Linux: setsid gives the tree (tauri + next dev + webview) its own
    # session/group, so the tracked PID == PGID and stop reaps it with one
    # negative-PID kill.
    setsid npm run tauri:dev > "$DESKTOP_LOG_FILE" 2>&1 < /dev/null &
  else
    # macOS / Git Bash (no setsid): nohup detaches from the controlling
    # terminal so it survives the terminal closing. No clean process group, so
    # 'octi stop' reaps the children by process/port match (see kill_desktop).
    nohup npm run tauri:dev > "$DESKTOP_LOG_FILE" 2>&1 < /dev/null &
  fi
  local dpid=$!
  echo "$dpid" > "$PID_FILE_DESKTOP"
  disown "$dpid" 2>/dev/null || true
  log_info "Desktop app started in the background (pid $dpid)."
  log_hint "Logs:  tail -f $DESKTOP_LOG_FILE"
  log_hint "Stop:  octi desktop --stop"
  log_hint "Attach instead next time with: octi desktop --foreground"
}

cmd_setup() {
  # Interactive first-run wizard: storage, secrets, admin account, provider,
  # default model, capabilities. Runs through the same code path as
  # `npm run setup`. Invoked by scripts/install.sh and re-runnable any time.
  cd "$PROJECT_DIR"
  exec npm run setup -- "$@"
}

cmd_tui() {
  if ! curl -sf "http://localhost:$API_PORT/api/health" >/dev/null 2>&1; then
    log_error "Backend is not running on port $API_PORT"
    log_hint "Start it first: octi start"
    return 1
  fi

  # Capture the invocation cwd before we cd into the project dir, so the
  # dev session opens pinned to the folder the user ran `octi tui` from
  # (claude-style). An explicit `--project /other` in "$@" still wins
  # because the entry-point parser uses the last `--project`.
  local user_cwd="$PWD"
  log_info "Connecting TUI to gateway at localhost:$API_PORT..."
  log_hint "Project: $user_cwd"
  cd "$PROJECT_DIR"
  # The `--` is load-bearing: without it npm claims `--project` as its own
  # config flag ("Unknown cli config") and never forwards it, so the TUI opened
  # with no project at all while this function's banner promised one. The agent
  # then answered questions about "this directory" from the user's default
  # workspace. `cmd_edit` below has always had the separator.
  API_PORT="$API_PORT" exec npm run tui -- --project "$user_cwd" "$@"
}

cmd_edit() {
  if ! curl -sf "http://localhost:$API_PORT/api/health" >/dev/null 2>&1; then
    log_error "Backend is not running on port $API_PORT"
    log_hint "Start it first: octi start"
    return 1
  fi

  # Default project = invocation cwd; user-supplied `--project /path` in
  # "$@" overrides because the parser keeps the last match.
  local user_cwd="$PWD"
  log_info "Launching TUI editor (gateway at localhost:$API_PORT)..."
  log_hint "Project: $user_cwd"
  cd "$PROJECT_DIR"
  API_PORT="$API_PORT" exec npm run tui:edit -- --project "$user_cwd" "$@"
}

cmd_doctor() {
  cd "$PROJECT_DIR"
  # No npm script for this one; `--import` is required by every entry point that
  # loads product code (role prompts are `.md` imports).
  exec npx tsx --import ./scripts/md-loader.mjs scripts/doctor.ts "$@"
}

cmd_recovery() {
  init_state_dir
  print_banner
  local mode
  mode=$(supervisor_mode)
  case "$mode" in
    recovery) log_error "Recovery mode is ACTIVE — the backend could not start" ;;
    running) log_info "Backend is running under the supervisor" ;;
    starting) log_warn "Backend is starting" ;;
    *) log_warn "No supervisor is running (start the backend with: octi start)" ;;
  esac
  [[ -f "$SUPERVISOR_STATE_FILE" ]] && log_hint "State: $SUPERVISOR_STATE_FILE"
  echo ""
  echo -e "  ${BOLD}When the backend cannot start${NC}, the supervisor serves recovery mode on"
  echo -e "  port $API_PORT (and $WEB_PORT when the web UI is down): open"
  echo -e "  ${CYAN}http(s)://<your host>/api/recovery${NC} for status, logs, retry, rebuild,"
  echo -e "  and starting the last good build. The API takes the token as a bearer token:"
  echo -e "    ${DIM}curl -H \"Authorization: Bearer <token>\" https://<host>/api/recovery/status${NC}"
  echo ""
  if [[ -n "${OCTIPUS_RECOVERY_TOKEN:-}" ]]; then
    log_info "Token: set by OCTIPUS_RECOVERY_TOKEN"
  elif [[ -f "$RECOVERY_TOKEN_FILE" ]]; then
    log_info "Token: $(cat "$RECOVERY_TOKEN_FILE")"
    log_hint "Keep it somewhere you can reach away from this machine (a password manager)."
  else
    log_warn "No token yet — it is created the first time the backend starts (octi start)."
  fi
  echo ""
}

cmd_help() {
  print_banner
  echo -e "  ${BOLD}Usage:${NC} octi <command> [options]"
  echo ""
  echo -e "  ${BOLD}Commands:${NC}"
  echo -e "    setup            Run the first-run / re-config wizard"
  echo -e "    start [client]   Start the backend, and attach a client if you name one"
  echo -e "    restart [client] Stop everything, then start again the same way"
  echo -e "    stop             Stop all Octipus processes"
  echo -e "    status           Show running state and service health"
  echo -e "    doctor [--json]  Run environment health checks (what's wired, what's missing)"
  echo -e "    logs [--web]     Tail backend logs (--web for web UI logs)"
  echo -e "    recovery         Recovery mode state, URL and token (keep the token for when you are away)"
  echo -e "    update [--dry-run] Update this installation from its existing source"
  echo -e "    uninstall        Remove Octipus (keeps data; --purge wipes everything)"
  echo -e "    help             Show this help message"
  echo ""
  echo -e "  ${BOLD}Clients${NC} ${DIM}— attach to a backend that is already running:${NC}"
  echo -e "    tui              Terminal chat — pins to the current directory as project"
  echo -e "    open             Web UI in the browser — starts it if it is not up"
  echo -e "    desktop [opts]   Desktop app, in the background"
  echo -e "                     ${DIM}--foreground/-f attach · --stop quit · --build make a bundle${NC}"
  echo -e "    edit             TUI editor — pins to the current directory as project"
  echo ""
  echo -e "  ${DIM}The same names work as a target: 'octi start tui' is a backend plus a TUI.${NC}"
  echo ""
  echo -e "  ${BOLD}Options:${NC}"
  echo -e "    --dev, -d        Development mode (hot reload) for start/restart"
  echo -e "    --rebuild        Rebuild backend, MCP server and web UI even if current"
  echo -e "    --web, -w        For 'logs': show web UI logs instead of backend"
  echo ""
  echo -e "  ${BOLD}Environment:${NC}"
  echo -e "    API_PORT         Backend API port (default: 3005)"
  echo -e "    WEB_PORT         Web UI port (default: 3007)"
  echo -e "    OCTI_REBUILD=1   Same as --rebuild"
  echo ""
}

cmd_uninstall_help() {
  print_banner
  echo -e "  ${BOLD}octi uninstall${NC} — remove Octipus from this machine."
  echo ""
  echo -e "  By default your data is ${BOLD}kept${NC} (database, vault, history) so a"
  echo -e "  later re-install picks up where you left off. Use --purge to wipe it."
  echo ""
  echo -e "  ${BOLD}Usage:${NC} octi uninstall [--purge] [--yes] [--dry-run]"
  echo ""
  echo -e "  ${BOLD}Options:${NC}"
  echo -e "    --purge        Also delete all data + secrets ($STATE_DIR) and Docker volumes"
  echo -e "    --yes, -y      Skip the confirmation prompt (for scripts/CI)"
  echo -e "    --dry-run, -n  Print what would be removed, change nothing"
  echo ""
  echo -e "  Per-project '.octipus/' folders inside your own repos are never touched."
  echo ""
}

cmd_uninstall() {
  local purge=false assume_yes=false dry_run=false
  for arg in "$@"; do
    case "$arg" in
      --purge)       purge=true ;;
      --yes|-y)      assume_yes=true ;;
      --dry-run|-n)  dry_run=true ;;
      -h|--help)     cmd_uninstall_help; return 0 ;;
      *)             log_warn "uninstall: ignoring unknown option '$arg'" ;;
    esac
  done

  init_state_dir
  print_banner

  # ── Resolve the install footprint ──────────────────────────────────────────
  local bin_dir="${OCTIPUS_BIN_DIR:-$HOME/.local/bin}"
  local bin_link="$bin_dir/octi"

  # Data dir: env override > .env DATA_DIR > default. '~' expanded against $HOME.
  local data_dir="$STATE_DIR/data"
  if [[ -f "$PROJECT_DIR/.env" ]]; then
    local _dd
    _dd=$(grep -E '^DATA_DIR=' "$PROJECT_DIR/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' || true)
    [[ -n "$_dd" ]] && data_dir="${_dd/#\~/$HOME}"
  fi
  [[ -n "${DATA_DIR:-}" ]] && data_dir="${DATA_DIR/#\~/$HOME}"

  # Docker deployment? Detect by our well-known container/volume names.
  local has_docker=false
  if command -v docker >/dev/null 2>&1 && [[ -f "$PROJECT_DIR/docker-compose.yml" ]]; then
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qE '^octipus-' \
       || docker volume ls --format '{{.Name}}' 2>/dev/null | grep -qE 'octipus-'; then
      has_docker=true
    fi
  fi

  # ── Show the plan ──────────────────────────────────────────────────────────
  echo -e "  ${BOLD}This will remove Octipus from your system.${NC}"
  echo ""
  log_step "Stop running backend / web / TUI processes"
  if [[ "$has_docker" == true ]]; then
    if [[ "$purge" == true ]]; then
      log_step "Docker: compose down ${BOLD}-v${NC} (containers + volumes deleted)"
    else
      log_step "Docker: compose down (containers only — named volumes kept)"
    fi
  fi
  if [[ -L "$bin_link" || -f "$bin_link" ]]; then
    log_step "Remove CLI link: $bin_link"
  fi
  if [[ "$purge" == true ]]; then
    log_step "Remove EVERYTHING under $STATE_DIR (app, vault, secrets)"
    if [[ "$STORAGE_MODE" == "external" ]]; then
      log_warn "PURGE removes Octipus's local state + secrets, but your ${BOLD}EXTERNAL database is NOT touched${NC}."
      log_warn "Octipus did not create that database (DATABASE_URL) and will not drop it — your users and data stay."
      log_hint "To wipe the data too, drop it yourself, e.g.:"
      log_hint "  psql \"\$DATABASE_URL\" -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'"
    else
      log_step "Remove embedded database at $data_dir"
      log_warn "PURGE: your database, vault secrets and chat history will be ${BOLD}permanently deleted${NC}."
    fi
  else
    log_step "Remove app checkout: $PROJECT_DIR"
    log_step "Keep your data: $data_dir"
    log_step "Back up secrets → $STATE_DIR/.env.uninstall-backup"
    log_hint "Re-install later to reuse the same data. Pass --purge to wipe it all."
  fi
  echo ""

  if [[ "$dry_run" == true ]]; then
    log_info "Dry run — nothing was changed."
    return 0
  fi

  # ── Confirm ────────────────────────────────────────────────────────────────
  if [[ "$assume_yes" != true ]]; then
    local word="uninstall"
    [[ "$purge" == true ]] && word="purge"
    printf "  Type '%s' to confirm: " "$word"
    local reply=""
    read -r reply || true
    if [[ "$reply" != "$word" ]]; then
      echo ""
      log_warn "Aborted — nothing was changed."
      return 1
    fi
    echo ""
  fi

  # ── Execute ────────────────────────────────────────────────────────────────
  log_step "Stopping processes..."
  kill_desktop
  kill_all_octipus
  log_info "Processes stopped"

  if [[ "$has_docker" == true ]]; then
    log_step "Tearing down Docker..."
    if [[ "$purge" == true ]]; then
      (cd "$PROJECT_DIR" && docker compose down -v --remove-orphans) >/dev/null 2>&1 \
        || log_warn "docker compose down failed — remove 'octipus-*' containers/volumes manually."
    else
      (cd "$PROJECT_DIR" && docker compose down --remove-orphans) >/dev/null 2>&1 \
        || log_warn "docker compose down failed — remove 'octipus-*' containers manually."
    fi
    log_info "Docker torn down"
  fi

  # Preserve secrets so the kept data stays decryptable (MASTER_KEY lives in .env).
  if [[ "$purge" != true && -f "$PROJECT_DIR/.env" ]]; then
    if cp -f "$PROJECT_DIR/.env" "$STATE_DIR/.env.uninstall-backup" 2>/dev/null; then
      chmod 600 "$STATE_DIR/.env.uninstall-backup" 2>/dev/null || true
      log_info "Secrets backed up to $STATE_DIR/.env.uninstall-backup"
    else
      log_warn "Could not back up .env — kept data may be unreadable without its MASTER_KEY."
    fi
  fi

  # Remove the PATH link — but only if it actually points at an Octipus install,
  # so we never clobber an unrelated 'octi' the user put there.
  if [[ -L "$bin_link" ]]; then
    local target
    target=$(readlink "$bin_link" 2>/dev/null || true)
    case "$target" in
      *"/.octipus/"*|"$PROJECT_DIR"/*) rm -f "$bin_link" && log_info "Removed $bin_link" ;;
      *) log_warn "Left $bin_link (points to $target — not this install)." ;;
    esac
  elif [[ -f "$bin_link" ]]; then
    rm -f "$bin_link" && log_info "Removed $bin_link"
  fi

  if [[ "$purge" == true ]]; then
    rm -rf "$STATE_DIR" && log_info "Removed $STATE_DIR (all data + secrets)"
  else
    # Drop only the app checkout when it's the installer path; keep data/backup.
    if [[ "$PROJECT_DIR" == "$STATE_DIR/app" ]]; then
      rm -rf "$PROJECT_DIR" && log_info "Removed app checkout $PROJECT_DIR"
    else
      log_warn "App checkout at $PROJECT_DIR looks like a dev clone — left in place."
      log_hint "Delete it yourself if you want it gone."
    fi
    rm -f "$PID_FILE_BACKEND" "$PID_FILE_WEB" "$PID_FILE_DESKTOP" \
      "$LOG_FILE" "$WEB_LOG_FILE" "$DESKTOP_LOG_FILE" 2>/dev/null || true
  fi

  echo ""
  print_banner
  if [[ "$purge" == true ]]; then
    log_info "Octipus fully removed. Goodbye. 🐙"
    if [[ "$STORAGE_MODE" == "external" ]]; then
      echo ""
      log_warn "Reminder: your EXTERNAL database was left intact — Octipus never drops a DB it didn't create."
      log_hint "Wipe it yourself if you want it gone: psql \"\$DATABASE_URL\" -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'"
    fi
  else
    log_info "Octipus uninstalled — your data is preserved:"
    log_hint "data:    $data_dir"
    log_hint "secrets: $STATE_DIR/.env.uninstall-backup"
    echo ""
    log_step "Reinstall any time:"
    log_hint "curl -fsSL https://raw.githubusercontent.com/PatriceA/octipus/main/scripts/install.sh | bash"
  fi
  echo ""
  log_hint "Per-project '.octipus/' folders in your own repos were left untouched."
}

# ─── Main ─────────────────────────────────────────────────────────────────────

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    update) node "$PROJECT_DIR/scripts/update.mjs" "$@" ;;
    setup)   cmd_setup "$@" ;;
    start)   cmd_start "$@" ;;
    stop)    cmd_stop ;;
    restart) cmd_restart "$@" ;;
    tui)     cmd_tui "$@" ;;
    edit)    cmd_edit "$@" ;;
    status)  cmd_status ;;
    doctor)  cmd_doctor "$@" ;;
    logs)    cmd_logs "$@" ;;
    recovery) cmd_recovery ;;
    open|web|webui) cmd_open ;;
    desktop) cmd_desktop "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
      log_error "Unknown command: $command"
      echo ""
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
