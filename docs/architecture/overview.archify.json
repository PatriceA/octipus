  "cards": [
    {
      "dot": "cyan",
      "title": "Entry points",
      "items": [
        "Web UI, Pi TUI and Tauri desktop all speak to one gateway",
        "Chat channels link platform users to Octipus accounts",
        "Gateway owns auth, sessions and the event stream"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agents and tools",
      "items": [
        "Root agent is an ordinary general worker keyed on AgentContext.root; delegation runs a fixed Root → Agent → Subagent tree",
        "Permission rules gate every tool call, including cli-native:* relays",
        "Vendor CLIs run as managed children with the same tools and permissions"
      ]
    },
    {
      "dot": "violet",
      "title": "Models and state",
      "items": [
        "Topics bind to models, never hardcoded names; direct HTTP adapters plus Ollama/LiteLLM",
        "Postgres + pgvector holds sessions, knowledge, memories and the tool_actions journal",
        "Vault stores every secret; the DB is the config source of truth"
      ]
    }
  ]
