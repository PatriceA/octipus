        "label": "User request path",
        "focus": [
          "clients",
          "channels",
          "gateway",
          "agents",
          "models",
          "providers"
        ],
        "note": "A message enters through a client or chat channel, the gateway hands it to the root agent, and the provider router calls the bound model."
      },
      {
        "id": "tool-loop",
        "label": "Tool loop and policy",
        "focus": [
          "agents",
          "tools",
          "security",
          "db"
        ],
        "note": "Every tool call passes the permission manager; mutating calls are journaled in Postgres for action recovery."
      },
      {
        "id": "cli-agents",
        "label": "CLI agents",
        "focus": [
          "agents",
          "cliagent",
          "vendorcli",
          "tools"
        ],
        "note": "Models routed to a vendor CLI run in a managed child that reaches Octipus tools through a per-run loopback MCP bridge."
      }
    ]
  },
