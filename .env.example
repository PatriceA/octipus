# ===========================================
# Assistant — Bootstrap Configuration
# ===========================================
# Only these settings are required in .env.
# All other configuration (LLM, channels, workspace, models, etc.)
# is managed via the web UI at Settings > Configuration.
#
# Quick start:
#   1. Copy this file to .env and fill in values, or run: bun run setup
#   2. Start the server: bun run dev
#   3. Open http://localhost:3005/setup to complete configuration

# -------------------------------------------
# Storage Mode
# -------------------------------------------
# 'embedded' = PGlite + in-memory cache (zero external deps, single-user)
# 'external' = PostgreSQL + Redis (production, multi-user)
STORAGE_MODE=external

# -------------------------------------------
# Database (external mode only)
# -------------------------------------------
DATABASE_URL=postgresql://assistant:your-password@localhost:5432/assistant
REDIS_URL=redis://localhost:6379

# Embedded mode data directory (default: ~/.assistant/data)
# DATA_DIR=~/.assistant/data

# -------------------------------------------
# Security (required, minimum 32 characters each)
# -------------------------------------------
# Auto-generated by: bun run setup
MASTER_KEY=
JWT_SECRET=
SESSION_SECRET=

# -------------------------------------------
# API Server
# -------------------------------------------
PORT=3005
HOST=127.0.0.1
