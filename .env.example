# ===========================================
# Assistant Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Or run: bun run setup

# -------------------------------------------
# Database (uses existing docker-services)
# -------------------------------------------
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/assistant
REDIS_URL=redis://localhost:6379

# -------------------------------------------
# Models
# -------------------------------------------
# Ollama (existing service on docker-services)
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=ollama/llama3.2
FALLBACK_MODEL=ollama/llama3.2

# Optional: LiteLLM Proxy (if using multiple providers)
# LITELLM_URL=http://localhost:4000
# LITELLM_API_KEY=sk-litellm-xxx

# Optional: Direct OpenAI
# OPENAI_API_KEY=sk-xxx

# -------------------------------------------
# Security (minimum 32 characters each)
# -------------------------------------------
MASTER_KEY=change-this-to-a-secure-32-char-key!!
JWT_SECRET=change-this-to-a-secure-32-char-key!!
SESSION_SECRET=change-this-to-a-secure-32-char-key!!

# -------------------------------------------
# API Server
# -------------------------------------------
PORT=3005
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3001,http://localhost:3005

# -------------------------------------------
# Channels (optional)
# -------------------------------------------
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Microsoft Teams
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# WebChat
WEBCHAT_PORT=3006

# -------------------------------------------
# Skills
# -------------------------------------------
ENABLED_SKILLS=filesystem,shell,git,browser
WORKSPACE_PATH=./workspace

# -------------------------------------------
# Integrations (existing docker-services)
# -------------------------------------------
# N8N
N8N_URL=http://localhost:5678
N8N_API_KEY=

# MCP Gateway
MCP_GATEWAY_URL=http://localhost:8811

# -------------------------------------------
# Voice (optional)
# -------------------------------------------
WHISPER_MODEL_PATH=
PIPER_MODEL_PATH=

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=info
