# ===========================================
# Octipus — Bootstrap Configuration
# ===========================================
# Only these settings are required in .env.
# All other configuration (LLM, channels, workspace, models, etc.)
# is managed via the web UI at Settings > Configuration.
#
# Quick start:
#   1. Copy this file to .env and fill in values, or run: bun run setup
#   2. Start the server: npm run dev
#   3. Open http://localhost:3005/setup to complete configuration

# -------------------------------------------
# Storage Mode
# -------------------------------------------
# 'embedded' = PGlite + in-memory cache (zero external deps, single-user)
# 'external' = PostgreSQL (production, multi-user)
STORAGE_MODE=external

# -------------------------------------------
# Database (external mode only)
# -------------------------------------------
# This .env is for the HOST process (`npm run dev`) and is authoritative for it.
# `docker-compose.yml` is a separate, self-contained stack: the app container
# reaches the DB at `octipus-db:5432` and ignores this URL. Compose publishes its
# Postgres on ${POSTGRES_PORT:-5442} — deliberately NOT 5432, so it cannot
# collide with a Postgres you already run there.
# Consequence: `docker compose up -d octipus-db` does NOT give you the database
# below — it creates a second, empty one. Point DATABASE_URL at 5442 if that is
# the one you meant.
DATABASE_URL=postgresql://octipus:your-password@localhost:5432/octipus
# Embedded mode data directory (default: ~/.octipus/data)
# DATA_DIR=~/.octipus/data

# -------------------------------------------
# Security (required, minimum 32 characters each)
# -------------------------------------------
# Auto-generated by: bun run setup
MASTER_KEY=
JWT_SECRET=
SESSION_SECRET=

# -------------------------------------------
# API Server
# -------------------------------------------
PORT=3005
HOST=127.0.0.1

# ===========================================
# Optional / Advanced
# ===========================================
# All values below have defaults — set only when you need to override.
#
# IMPORTANT — env vs. DB precedence:
#   * On first boot, values set here are seeded into the DB / vault by
#     src/config/migrate-env-to-db.ts (idempotent, runs once).
#   * After that, the **DB wins**. Editing this file later has no effect
#     unless the corresponding DB row is empty. Use the web UI
#     (Settings -> Configuration) to change values once the system is
#     running.
#   * To force a re-seed from .env, delete the `_system.envMigrated`
#     setting from the DB and restart.
#
# So: there is no "two of the same" risk — env is bootstrap-only for
# everything below, and the DB is canonical at runtime.

# -------------------------------------------
# Logging
# -------------------------------------------
# LOG_LEVEL=info               # trace | debug | info | warn | error | fatal
# LOG_FORMAT=pretty            # pretty | json

# -------------------------------------------
# LLM providers (env-only — prefer the vault via web UI)
# -------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1   # switch to https://api.moonshot.cn/v1 for China mainland
# --- GLM/Kimi as code agents via the `claude` binary (models cli/glm, cli/kimi) ---
# ZAI_CLI_MODEL=glm-4.6                 # GLM model the cli/glm agent runs
# MOONSHOT_CLI_MODEL=kimi-k2-0711-preview   # Kimi model the cli/kimi agent runs
# OPENROUTER_API_KEY=
# LITELLM_URL=http://localhost:4000
# LITELLM_API_KEY=

# -------------------------------------------
# Channels — bot tokens and webhook secrets
# -------------------------------------------
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=             # for Socket Mode
# SLACK_SIGNING_SECRET=
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# -------------------------------------------
# Workspace
# -------------------------------------------
# WORKSPACE_PATH=./workspace
# WORKSPACE_ADDITIONAL_PATHS=  # comma-separated absolute paths

# -------------------------------------------
# Agent / root agent tuning
# -------------------------------------------
# AGENT_DEFAULT_TIMEOUT=900000          # 15 min, default LLM call timeout
# AGENT_MAX_ITERATIONS=50               # max tool-call iterations per turn
# AGENT_MAX_TOKEN_BUDGET=100000         # per-session budget; 0 disables
# CONTEXT_WINDOW_SIZE=32000
# AGENT_TURN_TIMEOUT_MS=1800000       # 30 min, interactive channels
# AGENT_HOOK_TURN_TIMEOUT_MS=2700000  # 45 min, unattended hook runs

# -------------------------------------------
# Skill discovery
# -------------------------------------------
# Skill discovery mode for root agent skill injection.
#   hybrid (default): per-message discovery via triggers + vector + always_inject.
#   topic_only: legacy behavior — inject all active skills for the role's topic.
# Use topic_only as a rollback escape hatch if hybrid misbehaves in prod.
# SKILL_DISCOVERY_MODE=hybrid
#
# Embedding refill: skill description edits invalidate the embedding at
# write time; a cron re-runs the backfill script to refill lazily.
# Recommended cron: every 15 minutes:
#   */15 * * * *  cd /path/to/octipus && npm run db:backfill-skill-embeddings

# -------------------------------------------
# CORS / API
# -------------------------------------------
# CORS_ORIGINS=                # comma-separated; default = web port

# -------------------------------------------
# Voice / phone
# -------------------------------------------
# WHISPER_API_URL=
# PIPER_TTS_URL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# -------------------------------------------
# RAG / embeddings
# -------------------------------------------
# VOYAGE_API_KEY=
# OLLAMA_URL=http://localhost:11434

# -------------------------------------------
# Search
# -------------------------------------------
# SEARXNG_URL=

# -------------------------------------------
# OAuth (client IDs and secrets stored in vault, not here)
# -------------------------------------------
# PUBLIC_URL=

# -------------------------------------------
# Scheduling / cron
# -------------------------------------------
# TIMEZONE=UTC
