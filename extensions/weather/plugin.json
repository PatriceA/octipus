{
  "name": "weather",
  "version": "1.0.0",
  "description": "Get current weather and forecasts from wttr.in API",
  "author": "Octipus Plugin System",
  "main": "index.ts",
  "tools": [
    {
      "name": "get_weather",
      "description": "Get current weather data for a city",
      "parameters": {
        "city": {
          "type": "string",
          "description": "City name (e.g., 'London', 'New York')",
          "required": true
        }
      }
    },
    {
      "name": "get_forecast",
      "description": "Get multi-day weather forecast for a city",
      "parameters": {
        "city": {
          "type": "string",
          "description": "City name (e.g., 'London', 'New York')",
          "required": true
        },
        "days": {
          "type": "number",
          "description": "Number of forecast days (default: 3)",
          "required": false,
          "default": 3
        }
      }
    }
  ]
}